---
import { CONTENT } from "../constants/content";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import EntriesList from "../components/EntriesList.astro";
import BrandIdentity from "../components/BrandIdentity.astro";
import SidebarNav from "../components/SidebarNav.astro";
import ContactLinks from "../components/ContactLinks.astro";

const t = CONTENT;

const entries = await getCollection("entries", ({ data }) => {
  return data.draft !== true;
});

const allItems = [
  ...entries.map((entry) => ({
    title: entry.data.title,
    link: entry.data.type === "link" ? entry.data.url : `/entries/${entry.slug}`,
    isExternal: entry.data.type === "link",
    pubDate: entry.data.pubDate,
    type: entry.data.type,
    index: entry.data.index,
    description: entry.data.description,
  })),
  ...CONTENT.newsletters.map((n) => ({
    title: n.title,
    date: new Date(n.date),
    type: "link",
    link: n.link || "#",
    isExternal: true,
    pubDate: new Date(n.date),
    description: n.description,
  })),
]
  .sort(
    (a, b) => (b.pubDate || b.date).valueOf() - (a.pubDate || a.date).valueOf(),
  );
---

<Layout title="Home | Stefano Perelli">
  <div class="h-screen w-full bg-ink-white text-ink-text font-ink flex flex-col lg:flex-row overflow-hidden">
    <!-- Left Sidebar: Brand + Navbar (hidden on mobile, shown on desktop) -->
    <aside class="hidden lg:flex lg:w-64 lg:w-80 flex-shrink-0 border-r border-ink-black/10 flex-col p-8 lg:p-12 fixed h-screen">
      <div class="flex-1 flex flex-col">
        <!-- Brand Identity -->
        <div class="mb-12">
          <BrandIdentity />
        </div>

        <!-- Sidebar Navigation (desktop) -->
        <nav class="flex-1">
          <SidebarNav id="desktop-nav" />
        </nav>
      </div>
    </aside>

    <!-- Right Content: Scrollable Entries List (full width on mobile, flex-1 on desktop) -->
    <main class="flex-1 overflow-y-auto h-screen lg:ml-64 lg:ml-80">
      <div class="max-w-3xl mx-auto px-6 py-8 lg:px-8 lg:py-12 lg:px-16 lg:py-16">
        <!-- Mobile Header: Brand Identity (shown only on mobile) -->
        <div class="lg:hidden mb-8">
          <div class="mb-6">
            <BrandIdentity />
          </div>
        </div>

        <EntriesList
          entries={allItems}
          title="Buffer Outputs"
          subtitle="SESSION_2026"
        />
      </div>
    </main>

    <!-- Mobile Navigation (hamburger menu, hidden on desktop) -->
    <div class="lg:hidden">
      <SidebarNav id="mobile-nav" />
    </div>

    <!-- Contact Links (fixed position) -->
    <div class="fixed bottom-6 right-6 lg:bottom-8 lg:right-8 lg:bottom-12 lg:right-12 pointer-events-auto">
      <ContactLinks />
    </div>
  </div>
</Layout>

