---
import Layout from "../../layouts/Layout.astro";
import GlobalUI from "../../components/GlobalUI.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const experiments = (await getCollection("experiments")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
    new Date(date).toLocaleDateString("en-US", {
        month: "2-digit",
        day: "2-digit",
        year: "2-digit",
    });
---

<Layout title="Experiments | Synthetic Mess">
    <div
        class="min-h-screen bg-white text-zinc-900 font-sans selection:bg-accent selection:text-white flex flex-col relative"
    >
        <GlobalUI />

        <main
            class="flex-1 flex flex-col max-w-3xl mx-auto w-full px-4 pt-64 pb-32"
        >
            <header class="mb-24">
                <div class="flex items-center gap-4 mb-4">
                    <span
                        class="text-[10px] font-black tracking-[0.4em] uppercase text-accent"
                        >Laboratory // Vol.01</span
                    >
                    <div class="h-[1px] flex-1 bg-zinc-50"></div>
                </div>
                <!-- Restored massive header -->
                <h1
                    class="text-6xl md:text-9xl font-black tracking-tightest leading-none text-zinc-900"
                >
                    LAB<span class="text-accent italic">_</span>
                </h1>
                <p
                    class="text-xl md:text-2xl text-zinc-400 font-medium mt-6 max-w-xl leading-snug"
                >
                    Side projects, prototypes, and artifacts exploring the
                    boundary of human-machine interface.
                </p>
            </header>

            <header
                class="mb-12 flex justify-between items-end border-b-2 border-zinc-100 pb-3"
            >
                <span
                    class="text-[10px] font-black tracking-[0.4em] uppercase text-zinc-900"
                    >Lab Outputs // Vol.01</span
                >
                <span class="text-[9px] font-mono font-bold text-zinc-400"
                    >LAB_2026</span
                >
            </header>

            <div class="flex flex-col space-y-0.5">
                {
                    experiments.map((exp, index) => (
                        <a
                            href={`/experiments/${exp.slug}/`}
                            class="group flex items-center justify-between py-1.5 transition-all duration-300"
                        >
                            <div class="flex items-center gap-6 overflow-hidden">
                                <span class="text-[10px] font-mono font-bold text-zinc-300 group-hover:text-accent transition-colors w-6">
                                    {(index + 1).toString().padStart(2, "0")}
                                </span>
                                <span class="text-[10px] font-black text-accent bg-accent/5 px-2 py-0.5 rounded uppercase tracking-tighter w-10 text-center group-hover:bg-accent group-hover:text-white transition-all">
                                    EXP
                                </span>
                                <h3 class="text-xl md:text-2xl font-black tracking-tighter text-zinc-900 group-hover:text-accent transition-colors truncate">
                                    {exp.data.title}
                                </h3>
                            </div>
                            <div class="flex items-center gap-6 shrink-0">
                                <span class="text-xs font-mono font-bold text-zinc-300 group-hover:text-zinc-900 transition-colors tabular-nums uppercase">
                                    {formatDate(exp.data.pubDate)}
                                </span>
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    class="w-4 h-4 text-accent opacity-0 group-hover:opacity-100 transition-all transform -translate-x-3 group-hover:translate-x-0"
                                    stroke="currentColor"
                                    stroke-width="4"
                                >
                                    <path
                                        d="M5 12h14m-7-7l7 7-7 7"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </div>
                        </a>
                    ))
                }
            </div>
        </main>
        <Footer />
    </div>
</Layout>
