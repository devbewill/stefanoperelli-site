---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const experiments = (await getCollection("experiments")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
    new Date(date).toLocaleDateString("en-US", {
        month: "short",
        year: "numeric",
        day: "numeric",
    });
---

<Layout title="Experiments | Stefano Perelli">
    <div
        class="min-h-screen bg-white dark:bg-black text-black dark:text-white font-sans selection:bg-accent selection:text-black"
    >
        <Header />

        <main class="max-w-[1800px] mx-auto w-full">
            <div
                class="p-4 md:p-8 xl:min-h-[calc(100vh-400px)] border-b-[8px] border-black dark:border-white"
            >
                <h1
                    class="text-6xl md:text-[8vw] font-black tracking-extreme leading-none mb-6"
                >
                    EXPERIMENTS.
                </h1>
                <p
                    class="text-2xl md:text-5xl font-black tracking-tighter leading-[1.1] max-w-5xl"
                >
                    Side projects, prototypes, and things I'm building or
                    exploring in the lab.
                </p>
            </div>

            <div class="border-black dark:border-white">
                {
                    experiments.map((exp) => (
                        <a
                            href={`/experiments/${exp.slug}/`}
                            class="brutal-row block border-b-[8px] border-black dark:border-white p-4 md:p-8 relative group overflow-hidden"
                        >
                            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 relative z-10">
                                <div class="flex-1 w-full">
                                    <div class="flex flex-col md:flex-row md:items-center gap-3 mb-1">
                                        <span class="inline-block bg-accent text-black group-hover:bg-black group-hover:text-accent dark:group-hover:bg-black dark:group-hover:text-accent px-2 py-0.5 text-xs md:text-sm font-black tracking-tight whitespace-nowrap transition-colors">
                                            EXP
                                        </span>
                                        <span class="text-xs md:text-sm font-black tracking-tight opacity-50 block md:hidden">
                                            {formatDate(exp.data.pubDate)}
                                        </span>
                                    </div>
                                    <h2 class="text-xl md:text-2xl lg:text-3xl font-bold tracking-tight leading-tight mt-1 max-w-[95%]">
                                        {exp.data.title}
                                    </h2>
                                    <p class="text-xs md:text-sm font-medium tracking-normal mt-1 max-w-4xl opacity-80 leading-normal">
                                        {exp.data.description}
                                    </p>
                                    <div class="flex flex-wrap gap-2 mt-4">
                                        {exp.data.tags.map((tag) => (
                                            <span class="text-[10px] md:text-xs font-bold tracking-normal px-2 py-1 border-2 border-black dark:border-white text-black dark:text-white group-hover:border-accent group-hover:text-accent dark:group-hover:border-accent dark:group-hover:text-accent transition-colors">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                                <div class="hidden md:flex flex-row lg:flex-col items-center lg:items-end justify-between lg:justify-center shrink-0 text-right gap-4">
                                    <span class="text-sm md:text-base font-black tracking-tight">
                                        {formatDate(exp.data.pubDate)}
                                    </span>
                                    <span class="activity-arrow text-2xl md:text-3xl opacity-20 font-black transition-transform">
                                        →
                                    </span>
                                </div>
                            </div>
                        </a>
                    ))
                }
            </div>

            <div class="p-8 border-b-[8px] border-black dark:border-white">
                <a
                    href="/"
                    class="inline-block text-3xl font-black tracking-tightest bg-black text-white dark:bg-white dark:text-black px-6 py-4 hover:bg-accent hover:text-black dark:hover:bg-accent transition-colors"
                >
                    ← BACK TO BASE
                </a>
            </div>
        </main>
        <Footer />
    </div>
</Layout>
