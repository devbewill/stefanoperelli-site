---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const experiments = (await getCollection("experiments")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Experiments | Stefano Perelli">
    <div
        class="min-h-screen bg-white dark:bg-black text-black dark:text-white transition-colors duration-500 font-sans selection:bg-teal-100 dark:selection:bg-teal-900/30"
    >
        <Header />

        <main class="px-6 md:px-12 max-w-[800px] mx-auto py-12 md:py-16">
            <div class="mb-12">
                <h1 class="text-xl font-medium tracking-tight mb-2">
                    Experiments
                </h1>
                <p class="text-zinc-500">
                    Side projects, prototypes, and things I'm building or
                    exploring.
                </p>
            </div>

            <section>
                <ul class="space-y-8">
                    {
                        experiments.map((exp) => (
                            <li class="group">
                                <a
                                    href={`/experiments/${exp.slug}/`}
                                    class="block"
                                >
                                    <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4">
                                        <h2 class="text-lg font-bold group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors">
                                            {exp.data.title}
                                        </h2>
                                        <time
                                            datetime={exp.data.pubDate.toISOString()}
                                            class="text-xs font-mono text-zinc-400 shrink-0"
                                        >
                                            {exp.data.pubDate.toLocaleDateString(
                                                "en-us",
                                                {
                                                    year: "numeric",
                                                    month: "short",
                                                    day: "numeric",
                                                },
                                            )}
                                        </time>
                                    </div>
                                    <p class="text-zinc-600 dark:text-zinc-400 text-sm mt-1 mb-2 line-clamp-2">
                                        {exp.data.description}
                                    </p>
                                    <div class="flex gap-2">
                                        {exp.data.tags.map((tag) => (
                                            <span class="text-[10px] uppercase font-mono tracking-wider px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500">
                                                #{tag}
                                            </span>
                                        ))}
                                    </div>
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <div
                    class="mt-12 pt-8 border-t border-zinc-200 dark:border-zinc-800"
                >
                    <a
                        href="/"
                        class="text-sm font-medium hover:text-teal-500 transition-colors"
                        >← Back Home</a
                    >
                </div>
            </section>
        </main>
        <Footer />
    </div>
</Layout>
