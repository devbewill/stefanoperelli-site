---
import { CONTENT } from "../constants/content";
import Layout from "../layouts/Layout.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import SidebarLayout from "../components/SidebarLayout.astro";

const t = CONTENT;
---

<Layout title="Resume | Synthetic Mess">
  <SidebarLayout maxWidth="max-w-4xl">
    <header
      class="mb-12 flex justify-between items-end border-b border-black pb-3"
    >
      <span
        class="text-[11px] font-semibold tracking-[0.4em] uppercase"
        >Professional Record // Dossier</span
      >
      <div class="flex items-center gap-4">
        <a
          href="/stefano-perelli-resume.pdf"
          download
          class="text-[10px] font-sans font-semibold uppercase tracking-widest hover:underline"
        >
          ↓ Download PDF
        </a>
        <span class="text-[10px] font-sans font-semibold"
          >RESUME_2026</span
        >
      </div>
    </header>

    <section class="mb-32">
      <div class="space-y-1">
        {
          t.experiences.map((exp) => (
            <div class="py-12 border-b border-black/10 first:pt-0">
              <ExperienceItem {...exp} />
            </div>
          ))
        }
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      <section class="lg:col-span-4">
        <div class="flex items-center gap-6 mb-12">
          <h2
            class="text-[11px] font-semibold tracking-[0.5em] uppercase"
          >
            Capabilities
          </h2>
          <div class="h-[1px] flex-1 bg-black"></div>
        </div>
        <div class="space-y-12">
          {
            t.skills.map((category) => (
              <div class="space-y-4">
                <h3 class="text-[10px] font-semibold tracking-widest uppercase italic">
                  {category.title}
                </h3>
                <div class="flex flex-wrap gap-x-6 gap-y-2">
                  {category.skills.map((skill) => (
                    <span class="text-sm font-semibold">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="lg:col-span-8">
        <div class="flex items-center gap-6 mb-12">
          <h2
            class="text-[11px] font-semibold tracking-[0.5em] uppercase"
          >
            Selected Key Projects
          </h2>
          <div class="h-[1px] flex-1 bg-black"></div>
        </div>
        <div class="space-y-12">
          {
            t.projects.map((project) => (
              <div class="group space-y-2">
                <span class="text-[9px] font-sans font-semibold uppercase tabular-nums tracking-widest transition-colors">
                  {project.role}
                </span>
                <h3 class="text-2xl lg:text-3xl font-semibold">
                  {project.title}
                </h3>
                <p class=" text-sm font-semibold leading-relaxed">
                  {project.description}
                </p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </SidebarLayout>
</Layout>
