---
import { CONTENT } from "../constants";
import Layout from "../layouts/Layout.astro";
import GlobalUI from "../components/GlobalUI.astro";
import Footer from "../components/Footer.astro";
import ExperienceItem from "../components/ExperienceItem.astro";

const lang = "en";
const t = CONTENT[lang];
---

<Layout title="Resume | Synthetic Mess">
    <div
        class="min-h-screen bg-white text-zinc-900 font-sans selection:bg-accent selection:text-white flex flex-col"
    >
        <GlobalUI />

        <main
            class="flex-1 flex flex-col max-w-5xl mx-auto w-full px-8 pt-64 pb-32"
        >
            <header class="mb-24">
                <div class="flex items-center gap-4 mb-4">
                    <span
                        class="text-[10px] font-black tracking-[0.4em] uppercase text-accent"
                        >Dossier // Profile</span
                    >
                    <div class="h-[1px] flex-1 bg-zinc-50"></div>
                </div>
                <h1
                    class="text-6xl md:text-9xl font-black tracking-tightest leading-none text-zinc-900"
                >
                    RESUME<span class="text-accent italic">.</span>
                </h1>
                <p
                    class="text-xl md:text-2xl text-zinc-400 font-medium mt-6 max-w-2xl leading-snug"
                    data-i18n="resume_bio"
                >
                    {t.resume_bio}
                </p>
            </header>

            <section class="mb-32">
                <div class="flex items-center gap-6 mb-16">
                    <h2
                        class="text-[11px] font-black tracking-[0.5em] uppercase text-zinc-900"
                    >
                        Professional Record
                    </h2>
                    <div class="h-[1px] flex-1 bg-zinc-100"></div>
                </div>
                <div class="space-y-1">
                    {
                        t.experiences.map((exp) => (
                            <div class="py-12 border-b border-zinc-50 first:border-t">
                                <ExperienceItem {...exp} />
                            </div>
                        ))
                    }
                </div>
            </section>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-24">
                <section>
                    <div class="flex items-center gap-6 mb-12">
                        <h2
                            class="text-[11px] font-black tracking-[0.5em] uppercase text-zinc-900"
                        >
                            Capabilities
                        </h2>
                        <div class="h-[1px] flex-1 bg-zinc-100"></div>
                    </div>
                    <div class="space-y-12">
                        {
                            t.skills.map((category) => (
                                <div class="space-y-4">
                                    <h3 class="text-[10px] font-black tracking-widest uppercase text-accent italic">
                                        {category.title}
                                    </h3>
                                    <div class="flex flex-wrap gap-x-6 gap-y-2">
                                        {category.skills.map((skill) => (
                                            <span class="text-lg font-bold text-zinc-900">
                                                {skill}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </section>

                <section>
                    <div class="flex items-center gap-6 mb-12">
                        <h2
                            class="text-[11px] font-black tracking-[0.5em] uppercase text-zinc-900"
                        >
                            Selected Key Projects
                        </h2>
                        <div class="h-[1px] flex-1 bg-zinc-100"></div>
                    </div>
                    <div class="space-y-12">
                        {
                            t.projects.map((project) => (
                                <div class="group space-y-2">
                                    <span class="text-[9px] font-mono font-bold text-zinc-400 group-hover:text-accent uppercase tabular-nums tracking-widest transition-colors">
                                        {project.role}
                                    </span>
                                    <h3 class="text-2xl md:text-3xl font-black tracking-tight text-zinc-900">
                                        {project.title}
                                    </h3>
                                    <p class="text-zinc-500 text-sm font-medium leading-relaxed">
                                        {project.description}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </section>
            </div>
        </main>
        <Footer />
    </div>
</Layout>
