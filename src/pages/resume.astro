---
import { CONTENT } from "../constants";
import Layout from "../layouts/Layout.astro";
import GlobalUI from "../components/GlobalUI.astro";
import ExperienceItem from "../components/ExperienceItem.astro";

const t = CONTENT;
---

<Layout title="Resume | Synthetic Mess">
  <div
    class="min-h-screen bg-ink-white text-ink-text font-ink flex flex-col"
  >
    <GlobalUI />

    <main
      class="flex-1 flex flex-col max-w-3xl mx-auto w-full px-8 pt-64 pb-32"
    >
      <header
        class="mb-12 flex justify-between items-end border-b border-ink-black pb-3"
      >
        <span
          class="text-[11px] font-semibold tracking-[0.4em] uppercase text-ink-text"
          >Professional Record // Dossier</span
        >
        <span class="text-[10px] font-ink font-semibold text-ink-text-tertiary"
          >RESUME_2026</span
        >
      </header>

      <section class="mb-32">
        <div class="space-y-1">
          {
            t.experiences.map((exp) => (
              <div class="py-12 border-b border-ink-black/10 first:pt-0">
                <ExperienceItem {...exp} />
              </div>
            ))
          }
        </div>
      </section>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-16">
        <section class="md:col-span-4">
          <div class="flex items-center gap-6 mb-12">
            <h2
              class="text-[11px] font-semibold tracking-[0.5em] uppercase text-ink-text"
            >
              Capabilities
            </h2>
            <div class="h-[1px] flex-1 bg-ink-black"></div>
          </div>
          <div class="space-y-12">
            {
              t.skills.map((category) => (
                <div class="space-y-4">
                  <h3 class="text-[10px] font-semibold tracking-widest uppercase text-ink-text italic">
                    {category.title}
                  </h3>
                  <div class="flex flex-wrap gap-x-6 gap-y-2">
                    {category.skills.map((skill) => (
                      <span class="text-sm font-semibold text-ink-text">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section class="md:col-span-8">
          <div class="flex items-center gap-6 mb-12">
            <h2
              class="text-[11px] font-semibold tracking-[0.5em] uppercase text-ink-text"
            >
              Selected Key Projects
            </h2>
            <div class="h-[1px] flex-1 bg-ink-black"></div>
          </div>
          <div class="space-y-12">
            {
              t.projects.map((project) => (
                <div class="group space-y-2">
                  <span class="text-[9px] font-ink font-semibold text-ink-text-tertiary group-hover:text-ink-text uppercase tabular-nums tracking-widest transition-colors">
                    {project.role}
                  </span>
                  <h3 class="text-2xl md:text-3xl font-semibold tracking-ink-tight text-ink-text">
                    {project.title}
                  </h3>
                  <p class="text-ink-text-secondary text-sm font-semibold leading-relaxed">
                    {project.description}
                  </p>
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </main>
  </div>
</Layout>
