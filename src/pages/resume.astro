---
import Layout from "../layouts/Layout.astro";
import { CONTENT } from "../constants";
import ExperienceItem from "../components/ExperienceItem.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const lang = "en";
const t = CONTENT[lang];
---

<Layout title="Resume | Stefano Perelli">
    <div
        class="min-h-screen bg-white dark:bg-black text-black dark:text-white font-sans selection:bg-accent selection:text-black"
    >
        <Header />

        <main class="max-w-[1800px] mx-auto w-full">
            <div
                class="p-4 md:p-8 border-b-[8px] border-black dark:border-white"
            >
                <h1
                    class="text-6xl md:text-[8vw] font-black tracking-tight leading-none mb-6"
                >
                    RESUME.
                </h1>
                <p
                    class="text-2xl md:text-5xl font-black tracking-tighter leading-[1.1] max-w-5xl"
                >
                    10+ years of digital transformation, product management, and
                    building high-performing teams.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] w-full">
                <!-- Sidebar -->
                <div
                    class="lg:border-r-[16px] border-b-[8px] lg:border-b-0 border-black dark:border-white p-4 md:p-8 flex flex-col gap-12 lg:sticky lg:top-0 lg:h-[max-content]"
                >
                    <div>
                        <h2
                            class="text-4xl md:text-6xl font-black tracking-tight mb-6"
                        >
                            SKILLS.
                        </h2>
                        <div class="lang-content-it hidden">
                            {
                                CONTENT.it.skills.map((cat) => (
                                    <div class="mb-4">
                                        <h3 class="text-lg md:text-xl font-black tracking-tight mb-2">
                                            {cat.title}
                                        </h3>
                                        <ul class="flex flex-wrap gap-x-3 gap-y-1">
                                            {cat.skills.map((skill) => (
                                                <li class="text-sm md:text-base font-bold opacity-80 border-l-[3px] border-accent pl-2 leading-tight">
                                                    {skill}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                ))
                            }
                        </div>
                        <div class="lang-content-en">
                            {
                                CONTENT.en.skills.map((cat) => (
                                    <div class="mb-4">
                                        <h3 class="text-lg md:text-xl font-black tracking-tight mb-2">
                                            {cat.title}
                                        </h3>
                                        <ul class="flex flex-wrap gap-x-3 gap-y-1">
                                            {cat.skills.map((skill) => (
                                                <li class="text-lg font-bold border-b-[2px] border-accent py-[2px] leading-tight">
                                                    {skill}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="p-0 border-black dark:border-white">
                    <div
                        class="p-4 md:p-8 border-b-[8px] border-black dark:border-white"
                    >
                        <h2
                            class="text-5xl md:text-7xl font-black tracking-tight leading-none"
                            data-i18n="labels.experience"
                        >
                            {t.labels.experience}
                        </h2>
                    </div>

                    <div class="experience-list">
                        <div class="lang-content-it hidden">
                            {
                                CONTENT.it.experiences.map((exp) => (
                                    <ExperienceItem item={exp} />
                                ))
                            }
                        </div>
                        <div class="lang-content-en">
                            {
                                CONTENT.en.experiences.map((exp) => (
                                    <ExperienceItem item={exp} />
                                ))
                            }
                        </div>
                    </div>

                    <div
                        class="p-4 md:p-8 border-y-[8px] border-black dark:border-white mt-16"
                    >
                        <h2
                            class="text-5xl md:text-7xl font-black tracking-tight leading-none"
                            data-i18n="labels.projects"
                        >
                            {t.labels.projects}
                        </h2>
                    </div>

                    <div class="projects-list">
                        <div class="lang-content-it hidden">
                            {
                                CONTENT.it.projects.map((project) => (
                                    <div class="border-b-[8px] border-black dark:border-white p-4 md:p-8 group hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors">
                                        <div class="flex flex-col lg:flex-row gap-8">
                                            <div class="flex-1 w-full lg:w-1/3">
                                                <a
                                                    href={project.link}
                                                    class="block"
                                                >
                                                    <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-none mb-2">
                                                        {project.title}
                                                    </h3>
                                                </a>
                                                <p class="text-xl md:text-2xl font-bold tracking-tighter bg-accent text-black inline-block px-2 mt-2">
                                                    {project.role}
                                                </p>
                                            </div>
                                            <div class="flex-1 lg:w-2/3">
                                                <p class="text-xl md:text-2xl font-bold tracking-tighter leading-tight opacity-80 group-hover:opacity-100">
                                                    {project.description}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                        <div class="lang-content-en">
                            {
                                CONTENT.en.projects.map((project) => (
                                    <div class="border-b-[8px] border-black dark:border-white p-4 md:p-8 group hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors">
                                        <div class="flex flex-col lg:flex-row gap-8">
                                            <div class="flex-1 w-full lg:w-1/3">
                                                <a
                                                    href={project.link}
                                                    class="block"
                                                >
                                                    <h3 class="text-3xl md:text-5xl font-black tracking-tight leading-none mb-2">
                                                        {project.title}
                                                    </h3>
                                                </a>
                                                <p class="text-xl md:text-2xl font-bold tracking-tighter bg-accent text-black inline-block px-2 mt-2">
                                                    {project.role}
                                                </p>
                                            </div>
                                            <div class="flex-1 lg:w-2/3">
                                                <p class="text-xl md:text-2xl font-bold tracking-tighter leading-tight opacity-80 group-hover:opacity-100">
                                                    {project.description}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-8 border-b-[8px] border-black dark:border-white">
                <a
                    href="/"
                    class="inline-block text-3xl font-black tracking-tight bg-black text-white dark:bg-white dark:text-black px-6 py-4 hover:bg-accent hover:text-black dark:hover:bg-accent transition-colors"
                >
                    ← BACK TO BASE
                </a>
            </div>
        </main>
        <Footer />
    </div>
</Layout>
