---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import EntriesList from "../../components/EntriesList.astro";
import SidebarLayout from "../../components/SidebarLayout.astro";

const posts = (
  await getCollection(
    "entries",
    ({ data }) => data.type === "post" && data.draft !== true,
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Journal | Synthetic Mess">
  <SidebarLayout>
    <EntriesList
      entries={posts.map((post) => ({
        title: post.data.title,
        link: `/entries/${post.slug}/`,
        pubDate: post.data.pubDate,
        type: "post",
        description: post.data.description,
      }))}
      title="Archive Items"
      subtitle="Journal"
    />
  </SidebarLayout>
</Layout>
