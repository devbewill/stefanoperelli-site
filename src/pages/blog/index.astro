---
import Layout from "../../layouts/Layout.astro";
import GlobalUI from "../../components/GlobalUI.astro";
import { getCollection } from "astro:content";
import EntriesList from "../../components/EntriesList.astro";

const posts = (
  await getCollection(
    "entries",
    ({ data }) => data.type === "post" && data.draft !== true,
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Journal | Synthetic Mess">
  <div
    class="min-h-screen bg-ink-white text-ink-text font-ink flex flex-col relative overflow-x-hidden"
  >
    <GlobalUI />

    <main
      class="flex-1 flex flex-col max-w-2xl mx-auto w-full px-4 pt-64 pb-32"
    >
      <EntriesList
        entries={posts.map((post) => ({
          title: post.data.title,
          link: `/entries/${post.slug}/`,
          pubDate: post.data.pubDate,
          type: "post",
        }))}
        title="Archive Items"
        subtitle="Journal"
      />
    </main>
  </div>
</Layout>
