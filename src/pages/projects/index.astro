---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import EntriesTable from "../../components/EntriesTable.astro";
import SidebarLayout from "../../components/SidebarLayout.astro";

const projects = (
  await getCollection(
    "entries",
    ({ data }) => data.type === "project" && data.draft !== true,
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Projects | Synthetic Mess">
  <SidebarLayout>
    <EntriesTable
      entries={projects.map((prj, index) => ({
        title: prj.data.title,
        link: `/entries/${prj.slug}/`,
        pubDate: prj.data.pubDate,
        type: "project",
        index: index + 1,
        description: prj.data.description,
      }))}
      title="Selected Outputs"
      subtitle="Projects"
    />
  </SidebarLayout>
</Layout>
