---
import Layout from "../../layouts/Layout.astro";
import GlobalUI from "../../components/GlobalUI.astro";
import { getCollection } from "astro:content";
import EntriesList from "../../components/EntriesList.astro";

const projects = (
  await getCollection(
    "entries",
    ({ data }) => data.type === "project" && data.draft !== true,
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Projects | Synthetic Mess">
  <div
    class="min-h-screen bg-ink-white text-ink-text font-ink flex flex-col relative overflow-x-hidden"
  >
    <GlobalUI />

    <main
      class="flex-1 flex flex-col max-w-2xl mx-auto w-full px-4 pt-64 pb-32"
    >
      <EntriesList
        entries={projects.map((prj, index) => ({
          title: prj.data.title,
          link: `/entries/${prj.slug}/`,
          pubDate: prj.data.pubDate,
          type: "project",
          index: index + 1,
        }))}
        title="Selected Outputs"
        subtitle="Projects"
      />
    </main>
  </div>
</Layout>
