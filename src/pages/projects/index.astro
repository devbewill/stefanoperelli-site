---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../lib/entries";

const projects = await getProjects();
---

<Layout title="Projects | Synthetic Mess">
  <header class="page-head">
    <div class="wrap">
      <span class="kicker">Projects · {projects.length} experiments</span>
      <h1 class="h1">Small tools at the edge of <span class="mark">AI &amp; product</span>.</h1>
      <p class="sub">MVPs and side projects I build to test ideas, automate the boring parts and learn by doing.</p>
    </div>
  </header>

  <section class="wrap">
    <div class="masonry">
      {projects.map((p, i) => <ProjectCard entry={p} index={i + 1} feature={i === 0} />)}
    </div>
  </section>
</Layout>
