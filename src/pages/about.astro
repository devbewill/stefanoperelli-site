---
import { CONTENT } from "../constants";
import Layout from "../layouts/Layout.astro";
import GlobalUI from "../components/GlobalUI.astro";

const lang = "en";
const t = CONTENT[lang];
---

<Layout title="About | Synthetic Mess">
    <div
        class="h-screen w-full bg-white text-zinc-900 font-sans selection:bg-accent selection:text-white overflow-hidden relative flex flex-col"
    >
        <GlobalUI />

        <!-- Central Focus Layer -->
        <main
            class="flex-1 flex flex-col items-center z-10 overflow-y-auto no-scrollbar pt-64 pb-32"
        >
            <div class="w-full max-w-2xl px-4 space-y-16">
                <header class="space-y-6">
                    <span
                        class="text-[10px] font-black tracking-[0.4em] uppercase text-accent"
                        >Section // Manifesto</span
                    >
                    <h2
                        class="text-4xl md:text-5xl font-black tracking-tighter text-zinc-900 leading-[1.1]"
                    >
                        {t.bio}
                    </h2>
                </header>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-12 pt-8 border-t border-zinc-100"
                >
                    <div class="space-y-4">
                        <h3
                            class="text-[10px] font-black tracking-[0.3em] uppercase text-accent italic underline decoration-2 underline-offset-4"
                        >
                            Philosophy
                        </h3>
                        <p
                            class="text-base md:text-lg font-bold text-zinc-500 leading-relaxed"
                        >
                            {t.about_content.philosophy}
                        </p>
                    </div>
                    <div class="space-y-4">
                        <h3
                            class="text-[10px] font-black tracking-[0.3em] uppercase text-accent italic underline decoration-2 underline-offset-4"
                        >
                            Background
                        </h3>
                        <p
                            class="text-base md:text-lg font-bold text-zinc-500 leading-relaxed"
                        >
                            {t.about_content.background}
                        </p>
                    </div>
                </div>

                <div
                    class="pt-8 flex justify-between items-end opacity-20 group hover:opacity-100 transition-opacity"
                >
                    <span
                        class="text-[9px] font-mono uppercase tracking-[0.4em]"
                        >End of Dossier</span
                    >
                    <span class="text-[8px] font-mono tabular-nums"
                        >HASH: 6366F1_SYNTH</span
                    >
                </div>
            </div>
        </main>
    </div>
</Layout>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
