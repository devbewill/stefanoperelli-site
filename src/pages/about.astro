---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { CONTENT } from "../constants";

const t = CONTENT["en"];
---

<Layout title="About | Stefano Perelli">
 <div
 class="min-h-screen bg-white dark:bg-black text-black dark:text-white font-sans selection:bg-accent selection:text-black"
 >
 <Header />

 <main class="max-w-[1800px] mx-auto w-full">
 <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] w-full">
 <!-- Main Content -->
 <div
 class="p-4 md:p-8 xl:min-h-[calc(100vh-320px)] border-b-[8px] lg:border-b-0 lg:border-r-[16px] border-black dark:border-white flex flex-col gap-12"
 >
 <div>
 <h1
 class="text-6xl md:text-[8vw] font-black tracking-tight leading-none mb-12"
 >
 ABOUT.
 </h1>
 <p
 class="text-3xl md:text-5xl font-black tracking-tighter leading-[1.1] max-w-5xl"
 data-i18n="bio"
 >
 {t.bio}
 </p>
 </div>

 <div
 class="space-y-12 mt-12 pt-12 border-t-[8px] border-black dark:border-white"
 >
 <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
 <div>
 <h2
 class="text-4xl md:text-5xl font-black tracking-tight mb-4"
 >
 Philosophy
 </h2>
 <p
 class="text-xl md:text-2xl font-bold tracking-tighter leading-tight opacity-80"
 >
 I believe in radical transparency, extreme
 continuous improvement, and the raw power of
 well-structured chaos. User-centric,
 data-driven, and utterly opposed to boring
 interfaces.
 </p>
 </div>
 <div>
 <h2
 class="text-4xl md:text-5xl font-black tracking-tight mb-4"
 >
 Background
 </h2>
 <p
 class="text-xl md:text-2xl font-bold tracking-tighter leading-tight opacity-80"
 >
 I am dedicated to building high-quality,
 brutalist-inspired digital products.
 Bridging the gap between absurdly complex
 engineering and ruthless business goals.
 </p>
 </div>
 </div>
 </div>
 </div>

 <!-- Sidebar -->
 <div class="p-4 md:p-8 flex flex-col justify-between">
 <div>
 <h2
 class="text-4xl md:text-6xl font-black tracking-tight mb-8"
 >
 CONTACT.
 </h2>
 <a
 href="mailto:sedprc@gmail.com"
 class="block text-2xl md:text-4xl font-black tracking-tight border-[6px] border-black dark:border-white py-6 px-4 text-center hover:bg-accent hover:text-black hover:border-accent transition-colors mb-6"
 >
 sedprc@gmail.com
 </a>
 <a
 href="https://linkedin.com/in/stefanoperelli/"
 target="_blank"
 class="block text-2xl md:text-4xl font-black tracking-tight border-[6px] border-black dark:border-white py-6 px-4 text-center hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors"
 >
 LinkedIn ↗
 </a>
 </div>
 </div>
 </div>

 <div
 class="p-8 border-y-[8px] border-black dark:border-white mt-16 lg:mt-0"
 >
 <a
 href="/"
 class="inline-block text-3xl font-black tracking-tight bg-black text-white dark:bg-white dark:text-black px-6 py-4 hover:bg-accent hover:text-black dark:hover:bg-accent transition-colors"
 >
 ← BACK TO BASE
 </a>
 </div>
 </main>
 <Footer />
 </div>
</Layout>
