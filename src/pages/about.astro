---
import { CONTENT } from "../constants";
import Layout from "../layouts/Layout.astro";
import GlobalUI from "../components/GlobalUI.astro";

const t = CONTENT;
---

<Layout title={`${t.labels.about} | Synthetic Mess`}>
  <div
    class="h-screen w-full bg-ink-white text-ink-text font-ink overflow-hidden relative flex flex-col"
  >
    <GlobalUI />

    <!-- Central Focus Layer -->
    <main
      class="flex-1 flex flex-col items-center z-10 overflow-y-auto no-scrollbar pt-64 pb-32"
    >
      <div class="w-full max-w-2xl px-4 space-y-16">
        <header class="space-y-6">
          <span
            class="text-[10px] font-semibold tracking-[0.4em] uppercase text-ink-text"
            >Section // Manifesto</span
          >
          <h2
            class="text-2xl md:text-3xl font-semibold tracking-ink-tight text-ink-text leading-[1.1]"
          >
            {t.bio}
          </h2>
        </header>

        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-12 pt-8 border-t border-ink-black"
        >
          <div class="space-y-4">
            <h3
              class="text-[10px] font-semibold tracking-[0.3em] uppercase text-ink-text italic underline decoration-1 underline-offset-4"
            >
              Philosophy
            </h3>
            <p
              class="text-base md:text-lg font-semibold text-ink-text-secondary leading-relaxed"
            >
              {t.about_content.philosophy}
            </p>
          </div>
          <div class="space-y-4">
            <h3
              class="text-[10px] font-semibold tracking-[0.3em] uppercase text-ink-text italic underline decoration-1 underline-offset-4"
            >
              Background
            </h3>
            <p
              class="text-base md:text-lg font-semibold text-ink-text-secondary leading-relaxed"
            >
              {t.about_content.background}
            </p>
          </div>
        </div>

        <div
          class="pt-8 flex justify-between items-end opacity-20 group hover:opacity-100 transition-opacity"
        >
          <span class="text-[9px] font-ink uppercase tracking-[0.4em]"
            >End of Dossier</span
          >
          <span class="text-[8px] font-ink tabular-nums"
            >HASH: 6366F1_SYNTH</span
          >
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
