---
import "../styles/global.css";

interface Props {
    title?: string;
}

const { title = "Stefano Perelli | Project & Delivery Manager" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <!-- Fonts -->
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/style.css"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-mono/style.css"
        />
        <meta name="generator" content={Astro.generator} />
        <!-- Dark mode script to prevent flash -->
        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                return "dark"; // Default to dark as per App.tsx logic? App.tsx defaults to dark (useState(true)) and checks localStorage.
            })();
            if (theme === "dark") {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }
        </script>
    </head>
    <body class="antialiased">
        <slot />
    </body>
</html>
