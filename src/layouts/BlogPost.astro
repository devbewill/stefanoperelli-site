---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<Layout title={title}>
    <div
        class="min-h-screen bg-white dark:bg-black text-black dark:text-white font-sans selection:bg-accent selection:text-black"
    >
        <Header />

        <main class="max-w-[1800px] mx-auto w-full">
            <article class="w-full">
                <!-- Post Header -->
                <div
                    class="p-4 md:p-8 xl:p-16 border-b-[8px] border-black dark:border-white bg-black text-white dark:bg-white dark:text-black"
                >
                    <div
                        class="flex flex-col md:flex-row md:items-center gap-4 mb-8"
                    >
                        <span
                            class="inline-block bg-accent text-black px-4 py-1 text-2xl font-black tracking-tighter whitespace-nowrap"
                        >
                            RECORD
                        </span>
                        <time
                            datetime={pubDate.toISOString()}
                            class="text-2xl font-black tracking-tightest opacity-80"
                        >
                            {
                                pubDate.toLocaleDateString("en-us", {
                                    year: "numeric",
                                    month: "short",
                                    day: "numeric",
                                })
                            }
                        </time>
                        {
                            updatedDate && (
                                <span class="text-2xl font-black tracking-tightest opacity-50 ml-auto">
                                    UPD:{" "}
                                    {updatedDate.toLocaleDateString("en-us", {
                                        year: "numeric",
                                        month: "short",
                                        day: "numeric",
                                    })}
                                </span>
                            )
                        }
                    </div>

                    <h1
                        class="text-4xl md:text-5xl lg:text-[4vw] font-black tracking-tight leading-[0.9]"
                    >
                        {title}
                    </h1>

                    {
                        description && (
                            <p class="text-lg md:text-xl font-bold tracking-normal opacity-80 leading-tight">
                                {description}
                            </p>
                        )
                    }
                </div>

                <!-- Hero Image (if any) -->
                {
                    heroImage && (
                        <div class="w-full border-b-[8px] border-black dark:border-white">
                            <img
                                width={1800}
                                height={900}
                                src={heroImage}
                                alt=""
                                class="w-full object-cover max-h-[70vh]"
                            />
                        </div>
                    )
                }

                <!-- Content -->
                <div class="grid grid-cols-1 xl:grid-cols-[1fr_3fr] w-full">
                    <!-- Blank column for brutalist offset -->
                    <div
                        class="hidden xl:block border-r-[16px] border-black dark:border-white p-8"
                    >
                        <div class="sticky top-8">
                            <span
                                class="text-[150px] font-black tracking-extreme opacity-10 leading-none block transform translate-y-[-20px] ml-[-10px]"
                            >
                                *
                            </span>
                        </div>
                    </div>

                    <!-- Markdown Content -->
                    <div
                        class="col-span-12 lg:col-span-8 bg-white dark:bg-black text-black dark:text-white p-6 md:p-12 lg:p-20 border-[8px] md:border-[16px] border-black dark:border-white"
                    >
                        <div
                            class="prose prose-zinc dark:prose-invert max-w-none text-lg md:text-xl font-bold tracking-tight leading-[1.2]
 prose-a:text-accent prose-a:font-bold prose-a:bg-black prose-a:px-1 dark:prose-a:text-black dark:prose-a:bg-accent
 prose-img:border-[6px] prose-img:border-black dark:prose-img:border-white prose-img:rounded-none
 prose-code:bg-black prose-code:text-accent dark:prose-code:bg-white dark:prose-code:text-black prose-code:px-2 prose-code:py-1 prose-code:font-black
 prose-pre:border-[6px] prose-pre:border-black dark:prose-pre:border-white prose-pre:rounded-none"
                        >
                            <slot />
                        </div>
                    </div>
                </div>
            </article>

            <div class="p-8 border-y-[8px] border-black dark:border-white">
                <button
                    onclick="history.back()"
                    class="inline-block text-3xl font-black tracking-tightest bg-black text-white dark:bg-white dark:text-black px-6 py-4 hover:bg-accent hover:text-black dark:hover:bg-accent transition-colors"
                >
                    ← GO BACK
                </button>
            </div>
        </main>
    </div>
    <Footer />
</Layout>
