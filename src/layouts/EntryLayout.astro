---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import BackButton from "../components/BackButton.astro";

type Props = CollectionEntry<"entries">["data"];

const { title, description, pubDate, heroImage, type } = Astro.props;
---

<Layout title={`${title} | Synthetic Mess`}>
  <div
    class="min-h-screen bg-ink-white text-ink-text font-ink flex flex-col relative"
  >
    <main class="flex-1 flex flex-col max-w-2xl mx-auto w-full px-4 pt-64 pb-32">
      <article>
        <header class="mb-16 md:mb-24">
          <div class="flex items-center gap-4 mb-4">
            <span
              class="text-[10px] font-semibold tracking-[0.4em] uppercase text-ink-text"
            >
              {
                type === "post"
                  ? "Transmission // Insight"
                  : "Artifact // Project"
              }
            </span>
            <div class="h-[1px] flex-1 bg-ink-black"></div>
            <time
              datetime={pubDate.toISOString()}
              class="text-[10px] font-ink font-semibold text-ink-text-tertiary"
            >
              {
                pubDate.toLocaleDateString("en-us", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })
              }
            </time>
          </div>

          <h1
            class="text-4xl md:text-7xl font-semibold leading-[0.9] text-ink-text mb-8 uppercase"
          >
            {title}
          </h1>

          {
            description && (
              <p class="text-xl md:text-2xl text-ink-text-secondary font-semibold leading-relaxed max-w-2xl">
                {description}
              </p>
            )
          }
        </header>

        {
          heroImage && (
            <div class="mb-16 md:mb-24 overflow-hidden border border-ink-black">
              <img
                width={1600}
                height={800}
                src={heroImage}
                alt=""
                class="w-full object-cover max-h-[60vh] grayscale hover:grayscale-0 transition-all duration-1000"
              />
            </div>
          )
        }

        <div
          class="prose prose-zinc max-w-none
                    prose-h2:text-ink-text prose-h2:font-semibold prose-h2:tracking-ink-tight prose-h2:text-3xl prose-h2:uppercase
                    prose-h3:text-ink-text prose-h3:font-semibold prose-h3:text-xl
                    prose-p:text-ink-text-secondary prose-p:text-lg prose-p:leading-relaxed
                    prose-strong:text-ink-text prose-strong:font-semibold
                    prose-a:text-ink-text prose-a:border-b prose-a:border-ink-black/30 hover:prose-a:border-ink-black
                    prose-code:bg-ink-light prose-code:text-ink-text prose-code:px-1.5 prose-code:py-0.5 prose-code:border prose-code:border-ink-black prose-code:before:content-none prose-code:after:content-none
                    prose-pre:bg-ink-light prose-pre:border prose-pre:border-ink-black prose-pre:p-8
                    prose-img:border prose-img:border-ink-black
                    prose-blockquote:border-l-ink-black prose-blockquote:bg-ink-light prose-blockquote:py-2 prose-blockquote:px-8"
        >
          <slot />
        </div>

        <div class="mt-32 pt-12 border-t border-ink-black text-center">
          <BackButton />
        </div>
      </article>
    </main>
  </div>
</Layout>
