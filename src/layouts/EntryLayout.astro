---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import BackButton from "../components/BackButton.astro";
import SidebarLayout from "../components/SidebarLayout.astro";

type Props = CollectionEntry<"entries">["data"];

const { title, description, pubDate, heroImage, type } = Astro.props;
---

<Layout title={`${title} | Synthetic Mess`}>
  <SidebarLayout>
    <article>
      <header class="mb-16 lg:mb-24">
        <div class="flex items-center gap-4 mb-4">
          <span
            class="text-[10px] font-semibold tracking-[0.4em] uppercase"
          >
            {
              type === "post"
                ? "Transmission // Insight"
                : "Artifact // Project"
            }
          </span>
          <div class="h-[1px] flex-1 bg-ink-black"></div>
          <time
            datetime={pubDate.toISOString()}
            class="text-[10px] font-ink font-semibold"
          >
            {
              pubDate.toLocaleDateString("en-us", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })
            }
          </time>
        </div>

        <h1
          class="text-4xl lg:text-7xl font-semibold leading-[0.9] mb-8 uppercase"
        >
          {title}
        </h1>

        {
          description && (
            <p class="text-xl lg:text-2xl font-semibold leading-relaxed max-w-2xl">
              {description}
            </p>
          )
        }
      </header>

      {
        heroImage && (
          <div class="mb-16 lg:mb-24 overflow-hidden border border-ink-black">
            <img
              width={1600}
              height={800}
              src={heroImage}
              alt=""
              class="w-full object-cover max-h-[60vh] grayscale hover:grayscale-0 transition-all duration-1000"
            />
          </div>
        )
      }

      <div
        class="prose prose-zinc max-w-none
                  prose-h2:text-3xl prose-h2:font-semibold prose-h2:tracking-ink-tight prose-h2:uppercase
                  prose-h3:text-xl
                  prose-p:text-lg prose-p:leading-relaxed
                  prose-strong:font-semibold
                  prose-a:border-b prose-a:border-ink-black/30 hover:prose-a:border-ink-black
                  prose-code:bg-ink-light prose-code:px-1.5 prose-code:py-0.5 prose-code:border prose-code:border-ink-black prose-code:before:content-none prose-code:after:content-none
                  prose-pre:bg-ink-light prose-pre:border prose-pre:border-ink-black prose-pre:p-8
                  prose-img:border prose-img:border-ink-black
                  prose-blockquote:border-l-ink-black prose-blockquote:bg-ink-light prose-blockquote:py-2 prose-blockquote:px-8"
      >
        <slot />
      </div>

      <div class="mt-32 pt-12 border-t border-ink-black text-center">
        <BackButton />
      </div>
    </article>
  </SidebarLayout>
</Layout>
