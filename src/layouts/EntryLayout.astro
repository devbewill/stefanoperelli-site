---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"entries">["data"] & { readingTime?: string };

const props = Astro.props;
const { title, description, pubDate, heroImage, type, tags = [], readingTime } = props as typeof props & {
  heroImage?: string;
};
const backHref = type === "project" ? "/projects" : "/blog";
const backLabel = type === "project" ? "All projects" : "Journal";
---

<Layout title={`${title} | Synthetic Mess`}>
  <article class="article">
    <a class="back" href={backHref}>← {backLabel}</a>

    <div class="meta" style="margin-top:48px">
      <span class={`tagpill hot`}>{type === "project" ? "Project" : "Journal"}</span>
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
      </time>
      {readingTime && <span>· {readingTime} read</span>}
    </div>

    <h1>{title}</h1>
    {description && <p class="lede">{description}</p>}

    {tags.length > 0 && (
      <div class="chips" style="margin-top:24px">{tags.map((tag) => <span class="chip">#{tag}</span>)}</div>
    )}

    {heroImage && (
      <div class="hero-img"><img width={1600} height={800} src={heroImage} alt="" /></div>
    )}

    <div class="body prose prose-lg max-w-none prose-sm-fluo">
      <slot />
    </div>

    <div style="margin-top:96px;padding-top:32px;border-top:1px solid var(--rule)">
      <a class="link" href={backHref}>← Back to {backLabel}</a>
    </div>
  </article>
</Layout>
