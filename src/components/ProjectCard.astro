---
import type { Entry } from "../lib/entries";

interface Props {
  entry: Entry;
  index: number;
  feature?: boolean;
}

const { entry, index, feature = false } = Astro.props;
const d = entry.data;
const isFeatured = d.type === "project" && d.featured;
---

<a class={`pcard${feature ? " feature" : ""}`} href={`/entries/${entry.slug}/`}>
  <div class="pcard-top">
    <span class="pcard-num">{String(index).padStart(2, "0")}</span>
    <span class={`tagpill${isFeatured && !feature ? " hot" : ""}`}>{isFeatured ? "Featured" : "Experiment"}</span>
  </div>
  <h3>{d.title}</h3>
  {d.description && <p class="lead">{d.description}</p>}
  <span class="go">Read case</span>
</a>
