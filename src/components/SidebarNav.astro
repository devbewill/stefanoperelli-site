---
import { CONTENT } from "../constants";
const lang = "en";
const t = CONTENT[lang];
---

<div class="text-right z-20">
    <div class="mb-6">
        <span
            class="text-[10px] font-black tracking-[0.3em] uppercase text-zinc-400 block mb-1"
            >Curation</span
        >
        <span class="text-sm font-bold text-zinc-900">Stefano Perelli</span>
    </div>
    <nav class="flex flex-col items-end gap-2">
        <a
            href="/about"
            class="text-xs font-black tracking-widest uppercase text-zinc-400 hover:text-accent transition-colors"
            >About</a
        >
        <a
            href="/resume"
            class="text-xs font-black tracking-widest uppercase text-zinc-400 hover:text-accent transition-colors"
            >Resume</a
        >
        <a
            href="/blog"
            class="text-xs font-black tracking-widest uppercase text-zinc-400 hover:text-accent transition-colors"
            >Blog</a
        >
        <a
            href="/experiments"
            class="text-xs font-black tracking-widest uppercase text-zinc-400 hover:text-accent transition-colors"
            >Exp</a
        >
    </nav>
</div>
