---
import { CONTENT } from "../constants/content";
import FooterStatus from "./FooterStatus.astro";
interface Props {
  activeType?: string;
  id?: string;
}

const { activeType, id = "nav-toggle" } = Astro.props;
const t = CONTENT;
const pathname = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") return pathname === "/";
  return pathname === path || pathname.startsWith(path + "/");
};

// Mapping for content details
const isJournalActive = isActive("/blog") || activeType === "post";
const isExperimentsActive =
  isActive("/projects") ||
  activeType === "project" ||
  pathname.startsWith("/experiments");
---

<!-- Mobile Toggle (Hidden on Desktop) -->
<input type="checkbox" id={id} class="peer hidden nav-toggle" />
<label
  for={id}
  class="lg:hidden fixed top-10 right-10 z-[60] pointer-events-auto cursor-pointer p-1"
>
  <div class="relative w-6 h-5">
    <span
      class="absolute top-0 left-0 w-full h-[1px] bg-ink-black transition-all origin-left group-peer-checked:rotate-45"
    ></span>
    <span
      class="absolute top-1/2 left-0 -translate-y-1/2 w-full h-[1px] bg-ink-black transition-all group-peer-checked:opacity-0"
    ></span>
    <span
      class="absolute bottom-0 left-0 w-full h-[1px] bg-ink-black transition-all origin-left group-peer-checked:-rotate-45"
    ></span>
  </div>
</label>

<!-- Navigation Container -->
<div
  class="text-right z-[100] pointer-events-auto
    fixed lg:static top-0 right-0 h-screen lg:h-auto w-screen lg:w-auto
    bg-ink-white lg:bg-transparent
    flex flex-col items-end justify-center lg:justify-start
    p-10 lg:p-0
    translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out
    peer-checked:translate-x-0 border-l lg:border-l-0 border-ink-black"
>
  <!-- Header info (Hidden on Mobile for cleaner look) -->
  <div class="mb-10 hidden lg:block text-right">
    <span
      class="text-[10px] font-semibold tracking-[0.4em] uppercase text-ink-text-tertiary block mb-1"
      >Owner // System</span
    >
    <span class="text-sm font-semibold text-ink-text leading-none"
      >stefano_perelli</span
    >
  </div>

  <!-- Mobile Header info (Visible inside menu) -->
  <div class="lg:hidden mb-12 flex flex-col items-center">
    <span class="text-xs font-semibold text-ink-text">stefano_perelli</span>
  </div>

  <!-- Nav Links -->
  <nav class="flex flex-col items-end space-y-4 lg:space-y-4">

    <a
      href="/"
      class={`text-4xl lg:text-xs font-semibold tracking-widest uppercase transition-all  ${isActive("/") ? "text-ink-black border-b border-ink-black" : "text-ink-text hover:text-ink-black border-b border-transparent hover:border-ink-black"}`}
      >Home</a
    >
    <a
      href="/about"
      class={`text-4xl lg:text-xs font-semibold tracking-widest uppercase transition-all  ${isActive("/about") ? "text-ink-black border-b border-ink-black" : "text-ink-text hover:text-ink-black border-b border-transparent hover:border-ink-black"}`}
      >{t.labels.about}</a
    >
    <a
      href="/resume"
      class={`text-4xl lg:text-xs font-semibold tracking-widest uppercase transition-all  ${isActive("/resume") ? "text-ink-black border-b border-ink-black" : "text-ink-text hover:text-ink-black border-b border-transparent hover:border-ink-black"}`}
      >Resume</a
    >

    <a
      href="/blog"
      class={`text-4xl lg:text-xs font-semibold tracking-widest uppercase transition-all  ${isJournalActive ? "text-ink-black border-b border-ink-black" : "text-ink-text hover:text-ink-black border-b border-transparent hover:border-ink-black"}`}
      >Journal</a
    >
    <a
      href="/projects"
      class={`text-4xl lg:text-xs font-semibold tracking-widest uppercase transition-all  ${isExperimentsActive ? "text-ink-black border-b border-ink-black" : "text-ink-text hover:text-ink-black border-b border-transparent hover:border-ink-black"}`}
      >MVP</a
    >
  </nav>

  <!-- Footer Status (Anchored at bottom) -->
  <div class="mt-auto pt-10">
    <FooterStatus />
  </div>
</div>

<style>
  /* Custom Hamburger Logic without JS */
  .nav-toggle:checked ~ label div span:nth-child(1) {
    transform: rotate(45deg) translate(2px, -1px);
  }
  .nav-toggle:checked ~ label div span:nth-child(2) {
    opacity: 0;
    transform: translate(-20px, -50%);
  }
  .nav-toggle:checked ~ label div span:nth-child(3) {
    transform: rotate(-45deg) translate(2px, 1px);
  }
</style>
