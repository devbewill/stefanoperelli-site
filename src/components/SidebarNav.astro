---
import { CONTENT } from "../constants/content";
import FooterStatus from "./FooterStatus.astro";
interface Props {
  activeType?: string;
  id?: string;
}

const { activeType, id = "nav-toggle" } = Astro.props;
const t = CONTENT;
const pathname = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") return pathname === "/";
  return pathname === path || pathname.startsWith(path + "/");
};

// Mapping for content details
const isJournalActive = isActive("/blog") || activeType === "post";
const isExperimentsActive =
  isActive("/projects") ||
  activeType === "project" ||
  pathname.startsWith("/projects");

const navLinkClass = (active: boolean) =>
  `text-4xl lg:text-xs font-semibold tracking-widest uppercase transition-all ${
    active
      ? "text-black border-b border-black"
      : "text-black border-b border-transparent hover:border-black"
  }`;
---

<!-- Mobile Toggle (Hidden on Desktop) -->
<input type="checkbox" id={id} class="peer hidden nav-toggle" />
<label
  for={id}
  class="lg:hidden fixed top-10 right-10 z-[60] pointer-events-auto cursor-pointer p-1"
>
  <div class="relative w-6 h-5">
    <span
      class="absolute top-0 left-0 w-full h-[1px] bg-black transition-all origin-left"
    ></span>
    <span
      class="absolute top-1/2 left-0 -translate-y-1/2 w-full h-[1px] bg-black transition-all"
    ></span>
    <span
      class="absolute bottom-0 left-0 w-full h-[1px] bg-black transition-all origin-left"
    ></span>
  </div>
</label>

<!-- Navigation Container -->
<div
  class="text-right z-[100] pointer-events-auto
    fixed lg:static top-0 right-0 h-screen lg:h-auto w-screen lg:w-auto
    bg-white lg:bg-transparent
    flex flex-col items-end justify-center lg:justify-start
    p-10 lg:p-0
    translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out
    peer-checked:translate-x-0 border-l lg:border-l-0 border-black"
>
  <!-- Header info (Hidden on Mobile for cleaner look) -->
  <div class="mb-10 hidden lg:block text-right">
    <span
      class="text-[10px] font-semibold tracking-[0.4em] uppercase text-zinc-500 block mb-1"
      >Owner // System</span
    >
    <span class="text-sm font-semibold text-black leading-none"
      >stefano_perelli</span
    >
  </div>

  <!-- Mobile Header info (Visible inside menu) -->
  <div class="lg:hidden mb-12 flex flex-col items-center">
    <span class="text-xs font-semibold text-black">stefano_perelli</span>
  </div>

  <!-- Nav Links -->
  <nav class="flex flex-col items-end space-y-4 lg:space-y-4">
    <a href="/" class={navLinkClass(isActive("/"))}>Home</a>
    <a href="/about" class={navLinkClass(isActive("/about"))}>{t.labels.about}</a>
    <a href="/resume" class={navLinkClass(isActive("/resume"))}>Resume</a>
    <a href="/blog" class={navLinkClass(isJournalActive)}>Journal</a>
    <a href="/projects" class={navLinkClass(isExperimentsActive)}>Projects</a>
  </nav>

  <!-- Footer Status (Anchored at bottom) -->
  <div class="mt-auto pt-10">
    <FooterStatus />
  </div>
</div>

<style>
  /* Custom Hamburger Logic without JS */
  .nav-toggle:checked ~ label div span:nth-child(1) {
    transform: rotate(45deg) translate(2px, -1px);
  }
  .nav-toggle:checked ~ label div span:nth-child(2) {
    opacity: 0;
    transform: translate(-20px, -50%);
  }
  .nav-toggle:checked ~ label div span:nth-child(3) {
    transform: rotate(-45deg) translate(2px, 1px);
  }
</style>
