>
 <div
 class="px-4 py-8 md:px-8 md:py-16 max-w-[1800px] mx-auto flex flex-col md:flex-row justify-between items-center gap-8"
 >
 <span
 class="text-2xl md:text-4xl font-black tracking-tighter"
 data-i18n="labels.footer"
 >
 {t.labels.footer}
 </span>
 <div class="flex flex-wrap gap-4 md:gap-8">
 <a
 href="#"
 class="text-2xl md:text-4xl font-black tracking-tighter hover:text-accent transition-colors"
 >
 CV_PDF ↗
 </a>
 <a
 href="https://www.linkedin.com/in/stefanoperelli/"
 class="text-2xl md:text-4xl font-black tracking-tighter hover:text-accent transition-colors"
 >
