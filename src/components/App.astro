---
import { CONTENT } from "../constants";
import { getCollection } from "astro:content";

const lang = "en";
const t = CONTENT[lang];

const blogPosts = await getCollection("blog");
const experiments = await getCollection("experiments");

const allItems = [
    ...blogPosts.map((p) => ({
        ...p.data,
        link: `/blog/${p.slug}`,
        type: "POST",
        external: false,
    })),
    ...experiments.map((e) => ({
        ...e.data,
        link: `/experiments/${e.slug}`,
        type: "EXP",
        external: false,
    })),
    ...CONTENT.en.newsletters.map((n) => ({
        ...n,
        date: new Date(n.date),
        type: "NLTR",
        external: true,
        pubDate: new Date(n.date),
    })),
]
    .sort((a, b) => b.pubDate?.valueOf() - a.pubDate?.valueOf())
    .slice(0, 20);

const formatDate = (date: Date) =>
    new Date(date).toLocaleDateString("en-US", {
        month: "short",
        day: "2-digit",
        year: "2-digit",
    });
---

<div
    class="h-screen overflow-hidden bg-white text-zinc-900 font-sans selection:bg-accent selection:text-white flex flex-col p-8 md:p-16 lg:p-24 overflow-y-auto lg:overflow-hidden"
>
    <!-- Top Bar -->
    <header class="flex justify-between items-baseline mb-16 lg:mb-24 shrink-0">
        <div class="flex flex-col gap-1">
            <span
                class="text-[9px] font-black tracking-widest uppercase text-zinc-400"
                >Node Operator</span
            >
            <span class="text-xs font-bold text-zinc-900">Stefano Perelli</span>
        </div>
        <nav class="flex gap-12">
            <a
                href="/about"
                class="text-xs font-black tracking-widest uppercase hover:text-accent transition-colors"
                >About</a
            >
            <a
                href="/resume"
                class="text-xs font-black tracking-widest uppercase hover:text-accent transition-colors"
                >Resume</a
            >
        </nav>
    </header>

    <main
        class="flex-1 flex flex-col lg:flex-row gap-16 lg:gap-32 items-start overflow-hidden"
    >
        <!-- Brand / Focal Point -->
        <section
            class="lg:w-[45%] lg:h-full flex flex-col justify-between py-2"
        >
            <div class="space-y-12">
                <h1
                    class="text-[12vw] lg:text-[10vw] font-black tracking-tightest leading-[0.75] text-zinc-900"
                >
                    RAW<br />MODE<span class="text-accent">.</span>
                </h1>
                <p
                    class="text-xl md:text-2xl font-medium text-zinc-400 leading-snug max-w-sm"
                    data-i18n="bio"
                >
                    {t.bio}
                </p>
            </div>

            <!-- Mobile Only Activity Header -->
            <div
                class="lg:hidden flex items-center gap-4 mt-20 pt-12 border-t border-zinc-100"
            >
                <span
                    class="text-[10px] font-black tracking-widest uppercase text-accent"
                    >Latest Outputs</span
                >
            </div>
        </section>

        <!-- Activities Stream / High Contrast & No Cage -->
        <section class="flex-1 lg:h-full flex flex-col overflow-hidden">
            <div class="hidden lg:flex items-center gap-6 mb-12 shrink-0">
                <span
                    class="text-[10px] font-black tracking-[0.4em] uppercase text-accent"
                    >Record Buffer // Active Stream</span
                >
                <div class="h-[1px] flex-1 bg-zinc-100"></div>
                <span class="text-[9px] font-mono text-zinc-300 font-bold"
                    >20 ITEMS</span
                >
            </div>

            <div class="flex-1 overflow-y-auto no-scrollbar space-y-1">
                {
                    allItems.map((item) => (
                        <a
                            href={item.link}
                            target={item.external ? "_blank" : "_self"}
                            class="group block py-3 transition-all duration-300"
                        >
                            <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-4">
                                <div class="flex items-baseline gap-6">
                                    <span class="text-[10px] font-mono font-black text-zinc-900 w-12 shrink-0 group-hover:text-accent transition-colors">
                                        // {item.type}
                                    </span>
                                    <h3 class="text-2xl md:text-3xl font-black tracking-tight text-zinc-900 group-hover:text-accent transition-colors group-hover:translate-x-2 duration-500 ease-out">
                                        {item.title}
                                    </h3>
                                </div>
                                <span class="text-[10px] font-mono font-bold text-zinc-400 group-hover:text-zinc-900 tabular-nums uppercase whitespace-nowrap">
                                    {new Date(item.pubDate).toLocaleDateString(
                                        "en-US",
                                        {
                                            month: "short",
                                            day: "2-digit",
                                            year: "2-digit",
                                        },
                                    )}
                                </span>
                            </div>
                        </a>
                    ))
                }
            </div>
        </section>
    </main>

    <!-- Unified Minimal Footer -->
    <footer
        class="mt-16 lg:mt-24 pt-8 border-t border-zinc-50 flex flex-col md:flex-row justify-between items-center gap-6 shrink-0 opacity-40 hover:opacity-100 transition-opacity"
    >
        <div class="flex items-center gap-3">
            <div class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></div>
            <span
                class="text-[9px] font-mono uppercase text-zinc-500 tracking-widest"
                >System Status: Operative // Milan</span
            >
        </div>
        <div class="flex gap-12">
            <a
                href="https://linkedin.com/in/stefanoperelli/"
                target="_blank"
                class="text-[10px] font-black tracking-widest uppercase hover:text-accent"
                >LinkedIn</a
            >
            <a
                href="mailto:sedprc@gmail.com"
                class="text-[10px] font-black tracking-widest uppercase hover:text-accent"
                >Email Signal</a
            >
            <span
                class="text-[10px] font-mono text-zinc-400 uppercase tracking-widest"
                >© 2026 Rawmode Systems</span
            >
        </div>
    </footer>
</div>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
