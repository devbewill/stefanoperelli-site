---
import { CONTENT } from "../constants";
import { getCollection } from "astro:content";

import Header from "./Header.astro";
import Footer from "./Footer.astro";

// Load content server-side for initial render (defaulting to English for SEO/SSR)
const lang = "en";
const t = CONTENT[lang];

// Fetch dynamic content from Astro content collections
const blogPosts = await getCollection("blog");
const experiments = await getCollection("experiments");

// Format collection items into unified activity shape
const fromBlog = blogPosts.map((item) => ({
    type: "Post" as const,
    title: item.data.title,
    description: item.data.description,
    link: `/blog/${item.slug}`,
    date: item.data.pubDate,
    external: false,
}));

const fromExperiments = experiments.map((item) => ({
    type: "Side Project" as const,
    title: item.data.title,
    description: item.data.description,
    link: `/experiments/${item.slug}`,
    date: item.data.pubDate,
    external: false,
}));

// Newsletters: title + external Substack link, stored per-language in constants.ts
const fromNewslettersIt = CONTENT.it.newsletters.map((n) => ({
    type: "Newsletter" as const,
    title: n.title,
    description: n.description ?? "",
    link: n.link,
    date: new Date(n.date),
    external: true,
}));

const fromNewslettersEn = CONTENT.en.newsletters.map((n) => ({
    type: "Newsletter" as const,
    title: n.title,
    description: n.description ?? "",
    link: n.link,
    date: new Date(n.date),
    external: true,
}));

// Merge and sort by date descending
const sortByDate = (a, b) =>
    new Date(b.date).getTime() - new Date(a.date).getTime();

const itActivities = [
    ...fromBlog,
    ...fromExperiments,
    ...fromNewslettersIt,
].sort(sortByDate);
const enActivities = [
    ...fromBlog,
    ...fromExperiments,
    ...fromNewslettersEn,
].sort(sortByDate);

// Format date for display
const formatDate = (date: Date) =>
    new Date(date).toLocaleDateString("en-US", {
        month: "short",
        year: "numeric",
    });
---

<div
    class="min-h-screen bg-white dark:bg-black text-black dark:text-white transition-colors duration-500 font-sans selection:bg-teal-100 dark:selection:bg-teal-900/30"
>
    <Header />

    <main class="px-6 md:px-12 max-w-[1600px] mx-auto pb-32">
        <div class="flex flex-col md:flex-row gap-12 md:gap-24">
            <!-- Sidebar -->
            <div class="w-full md:w-[368px] md:shrink-0">
                <div class="md:sticky md:top-16 space-y-12">
                    <div
                        id="about"
                        class="pt-8 border-t border-zinc-200 dark:border-zinc-800"
                    >
                        <p
                            class="text-md leading-relaxed text-zinc-800 dark:text-zinc-200"
                            data-i18n="bio"
                        >
                            {t.bio}
                        </p>
                    </div>
                    <div class="space-y-0">
                        <div
                            class="py-4 border-t border-zinc-200 dark:border-zinc-800 flex justify-between items-center group"
                        >
                            <a
                                href="mailto:sedprc@gmail.com"
                                class="text-sm hover:text-teal-500 transition-colors underline underline-offset-4 decoration-zinc-300 dark:decoration-zinc-700 group-hover:decoration-teal-500"
                            >
                                Mail me
                            </a>
                        </div>
                        <div
                            class="py-4 border-t border-zinc-200 dark:border-zinc-800 border-b flex justify-between items-center group"
                        >
                            <a
                                href="https://www.linkedin.com/in/stefanoperelli/"
                                class="text-sm hover:text-accent transition-colors underline underline-offset-4 decoration-zinc-300 dark:decoration-zinc-700 group-hover:decoration-accent"
                            >
                                Linkedin
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main content -->
            <div class="flex-1 space-y-24">
                <!-- NOW section -->
                <section id="now">
                    <div
                        class="pt-8 border-t border-zinc-200 dark:border-zinc-800 mb-8"
                    >
                        <div class="flex items-center gap-3">
                            <h2
                                class="text-sm font-medium text-zinc-500 uppercase tracking-wider"
                                data-i18n="labels.now"
                            >
                                {t.labels.now}
                            </h2>
                            <span class="relative flex h-2 w-2">
                                <span
                                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"
                                ></span>
                                <span
                                    class="relative inline-flex rounded-full h-2 w-2 bg-teal-500"
                                ></span>
                            </span>
                        </div>
                    </div>
                    <p
                        class="text-lg text-zinc-800 dark:text-zinc-200 leading-relaxed font-medium"
                        data-i18n="now"
                    >
                        {t.now}
                    </p>
                </section>

                <!-- ACTIVITY LOG -->
                <section id="activities">
                    <div
                        class="pt-8 border-t border-zinc-200 dark:border-zinc-800 mb-8"
                    >
                        <h2
                            class="text-sm font-medium text-zinc-500 uppercase tracking-wider"
                            data-i18n="labels.activities"
                        >
                            {t.labels.activities}
                        </h2>
                    </div>

                    <!-- Italian list (hidden by default, JS language switcher toggles it) -->
                    <div class="lang-content-it hidden">
                        <div
                            class="divide-y divide-zinc-200 dark:divide-zinc-800 border-b border-zinc-200 dark:border-zinc-800"
                        >
                            {
                                itActivities.map((activity) => (
                                    <div class="py-6 group">
                                        <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4">
                                            <div class="space-y-1 flex-1">
                                                <div class="flex items-center gap-3">
                                                    <span class="text-[10px] font-mono uppercase tracking-widest text-teal-600 dark:text-teal-400 px-2 py-0.5 border border-teal-600/20 dark:border-teal-400/20 rounded">
                                                        {activity.type}
                                                    </span>
                                                    <h3 class="text-md font-bold group-hover:text-teal-500 transition-colors">
                                                        <a
                                                            href={activity.link}
                                                            target={
                                                                activity.external
                                                                    ? "_blank"
                                                                    : "_self"
                                                            }
                                                            rel={
                                                                activity.external
                                                                    ? "noopener noreferrer"
                                                                    : ""
                                                            }
                                                            class="hover:underline underline-offset-4 decoration-teal-500"
                                                        >
                                                            {activity.title}
                                                            {activity.external && (
                                                                <span class="ml-1 opacity-40 text-sm">
                                                                    ↗
                                                                </span>
                                                            )}
                                                        </a>
                                                    </h3>
                                                </div>
                                                {activity.description && (
                                                    <p class="text-sm text-zinc-500 dark:text-zinc-400 max-w-2xl">
                                                        {activity.description}
                                                    </p>
                                                )}
                                            </div>
                                            <span class="text-xs font-mono text-zinc-400 dark:text-zinc-600 shrink-0">
                                                {formatDate(activity.date)}
                                            </span>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <!-- English list (shown by default) -->
                    <div class="lang-content-en">
                        <div
                            class="divide-y divide-zinc-200 dark:divide-zinc-800 border-b border-zinc-200 dark:border-zinc-800"
                        >
                            {
                                enActivities.map((activity) => (
                                    <div class="py-6 group">
                                        <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4">
                                            <div class="space-y-1 flex-1">
                                                <div class="flex items-center gap-3">
                                                    <span class="text-[10px] font-mono uppercase tracking-widest text-teal-600 dark:text-teal-400 px-2 py-0.5 border border-teal-600/20 dark:border-teal-400/20 rounded">
                                                        {activity.type}
                                                    </span>
                                                    <h3 class="text-md font-bold group-hover:text-teal-500 transition-colors">
                                                        <a
                                                            href={activity.link}
                                                            target={
                                                                activity.external
                                                                    ? "_blank"
                                                                    : "_self"
                                                            }
                                                            rel={
                                                                activity.external
                                                                    ? "noopener noreferrer"
                                                                    : ""
                                                            }
                                                            class="hover:underline underline-offset-4 decoration-teal-500"
                                                        >
                                                            {activity.title}
                                                            {activity.external && (
                                                                <span class="ml-1 opacity-40 text-sm">
                                                                    ↗
                                                                </span>
                                                            )}
                                                        </a>
                                                    </h3>
                                                </div>
                                                {activity.description && (
                                                    <p class="text-sm text-zinc-500 dark:text-zinc-400 max-w-2xl">
                                                        {activity.description}
                                                    </p>
                                                )}
                                            </div>
                                            <span class="text-xs font-mono text-zinc-400 dark:text-zinc-600 shrink-0">
                                                {formatDate(activity.date)}
                                            </span>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <Footer />
</div>
