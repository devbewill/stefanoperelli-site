---
import { CONTENT } from "../constants";
import ExperienceItem from "./ExperienceItem.astro";

// Load content server-side for initial render (defaulting to English for SEO/SSR)
const lang = "en";
const t = CONTENT[lang];
---

<div
    class="min-h-screen bg-white dark:bg-black text-black dark:text-white transition-colors duration-500 font-sans selection:bg-teal-100 dark:selection:bg-teal-900/30"
>
    <header
        class="px-6 py-12 md:px-12 md:py-16 flex justify-between items-start max-w-[1600px] mx-auto"
    >
        <div>
            <h1 class="text-xl font-medium tracking-tight">Stefano Perelli,</h1>
            <p class="text-xl text-teal-600 dark:text-teal-400 font-medium">
                Project & Delivery Manager
            </p>
        </div>
        <nav class="flex items-center gap-6 md:gap-8">
            <a
                href="#about"
                class="text-xl font-medium hover:text-accent transition-colors hidden sm:block"
                data-i18n="labels.about"
            >
                {t.labels.about}
            </a>
            <div class="flex gap-2">
                <button
                    id="lang-toggle"
                    class="text-[10px] font-mono tracking-widest border border-zinc-200 dark:border-zinc-800 px-3 py-1 rounded-full uppercase hover:border-teal-500 hover:text-teal-500 transition-colors"
                >
                    {lang === "it" ? "EN" : "IT"}
                </button>
                <button
                    id="theme-toggle"
                    class="text-[10px] font-mono tracking-widest border border-zinc-200 dark:border-zinc-800 px-3 py-1 rounded-full uppercase hover:border-accent hover:text-accent transition-colors"
                >
                    {
                        /* Initial text will be set by JS or hardcoded, JS will update it */
                    }
                    <span class="dark:hidden">Dark</span>
                    <span class="hidden dark:inline">Light</span>
                </button>
            </div>
        </nav>
    </header>

    <main class="px-6 md:px-12 max-w-[1600px] mx-auto pb-32">
        <div class="flex flex-col md:flex-row gap-12 md:gap-24">
            <div class="w-full md:w-[368px] md:shrink-0">
                <div class="md:sticky md:top-16 space-y-12">
                    <div
                        id="about"
                        class="pt-8 border-t border-zinc-200 dark:border-zinc-800"
                    >
                        <p
                            class="text-md leading-relaxed text-zinc-800 dark:text-zinc-200"
                            data-i18n="bio"
                        >
                            {t.bio}
                        </p>
                    </div>
                    <div class="space-y-0">
                        <div
                            class="py-4 border-t border-zinc-200 dark:border-zinc-800 flex justify-between items-center group"
                        >
                            <a
                                href="mailto:sedprc@gmail.com"
                                class="text-sm hover:text-teal-500 transition-colors underline underline-offset-4 decoration-zinc-300 dark:decoration-zinc-700 group-hover:decoration-teal-500"
                            >
                                Mail me
                            </a>
                        </div>
                        <div
                            class="py-4 border-t border-zinc-200 dark:border-zinc-800 border-b flex justify-between items-center group"
                        >
                            <a
                                href="https://www.linkedin.com/in/stefanoperelli/"
                                class="text-sm hover:text-accent transition-colors underline underline-offset-4 decoration-zinc-300 dark:decoration-zinc-700 group-hover:decoration-accent"
                            >
                                Linkedin
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-1 space-y-32">
                <section id="experience">
                    <div
                        class="pt-8 border-t border-zinc-200 dark:border-zinc-800 mb-12"
                    >
                        <h2
                            class="text-sm font-medium text-zinc-500 uppercase tracking-wider"
                            data-i18n="labels.experience"
                        >
                            {t.labels.experience}
                        </h2>
                    </div>
                    <div class="experience-list">
                        {
                            /*
              Since Experince data is complex array, switching it via simple textContent replacement is hard.
              We will render BOTH lists (IT and EN) and toggle visibility.
              This is slightly heavier DOM but robust for static site i18n without routing.
            */
                        }
                        <div class="lang-content-it hidden">
                            {
                                CONTENT.it.experiences.map((exp) => (
                                    <ExperienceItem item={exp} />
                                ))
                            }
                        </div>
                        <div class="lang-content-en">
                            {
                                CONTENT.en.experiences.map((exp) => (
                                    <ExperienceItem item={exp} />
                                ))
                            }
                        </div>
                    </div>
                </section>

                <section id="projects">
                    <div
                        class="pt-8 border-t border-zinc-200 dark:border-zinc-800 mb-12"
                    >
                        <h2
                            class="text-sm font-medium text-zinc-500 uppercase tracking-wider"
                            data-i18n="labels.projects"
                        >
                            {t.labels.projects}
                        </h2>
                    </div>
                    <div class="projects-list">
                        <div class="lang-content-it hidden">
                            {
                                CONTENT.it.projects.map((project) => (
                                    <div class="py-2 first:pt-0 group cursor-default border-b border-zinc-200 dark:border-zinc-800 last:border-b-0">
                                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-16">
                                            <div>
                                                <a
                                                    href={project.link}
                                                    class="block text-sm group-hover:text-teal-500 transition-colors"
                                                >
                                                    <h3 class="text-lg font-bold mb-2">
                                                        {project.title}
                                                    </h3>
                                                </a>
                                                <p class="text-zinc-500 text-sm italic">
                                                    {project.role}
                                                </p>
                                            </div>
                                            <div>
                                                <p class="text-sm leading-relaxed max-w-xl text-zinc-500 dark:text-zinc-400">
                                                    {project.description}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                        <div class="lang-content-en">
                            {
                                CONTENT.en.projects.map((project) => (
                                    <div class="py-2 first:pt-0 group cursor-default border-b border-zinc-200 dark:border-zinc-800 last:border-b-0">
                                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-16">
                                            <div>
                                                <a
                                                    href={project.link}
                                                    class="block text-sm group-hover:text-teal-500 transition-colors"
                                                >
                                                    <h3 class="text-lg font-bold mb-2">
                                                        {project.title}
                                                    </h3>
                                                </a>
                                                <p class="text-zinc-500 text-sm italic">
                                                    {project.role}
                                                </p>
                                            </div>
                                            <div>
                                                <p class="text-sm leading-relaxed max-w-xl text-zinc-500 dark:text-zinc-400">
                                                    {project.description}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </section>

                <section id="skills">
                    <div
                        class="pt-8 border-t border-zinc-200 dark:border-zinc-800 mb-12"
                    >
                        <h2
                            class="text-sm font-medium text-zinc-500 uppercase tracking-wider"
                            data-i18n="labels.skills"
                        >
                            {t.labels.skills}
                        </h2>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                        {/* Render both */}
                        <div class="contents lang-content-it hidden">
                            {
                                CONTENT.it.skills.map((cat) => (
                                    <div class="space-y-6">
                                        <h3 class="text-xs font-bold uppercase tracking-widest text-teal-600 dark:text-teal-400 border-l-2 border-accent pl-3">
                                            {cat.title}
                                        </h3>
                                        <ul class="space-y-3">
                                            {cat.skills.map((skill) => (
                                                <li class="text-sm flex gap-3 items-start text-zinc-800 dark:text-zinc-300">
                                                    <span class="text-accent mt-1">
                                                        •
                                                    </span>
                                                    {skill}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                ))
                            }
                        </div>
                        <div class="contents lang-content-en">
                            {
                                CONTENT.en.skills.map((cat) => (
                                    <div class="space-y-6">
                                        <h3 class="text-xs font-bold uppercase tracking-widest text-teal-600 dark:text-teal-400 border-l-2 border-accent pl-3">
                                            {cat.title}
                                        </h3>
                                        <ul class="space-y-3">
                                            {cat.skills.map((skill) => (
                                                <li class="text-sm flex gap-3 items-start text-zinc-800 dark:text-zinc-300">
                                                    <span class="text-accent mt-1">
                                                        •
                                                    </span>
                                                    {skill}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <footer
        class="px-6 py-20 md:px-12 max-w-[1600px] mx-auto border-t border-zinc-200 dark:border-zinc-800"
    >
        <div
            class="flex flex-col md:flex-row justify-between items-center gap-8 opacity-40 text-[10px] uppercase font-mono tracking-widest"
        >
            <span data-i18n="labels.footer">{t.labels.footer}</span>
            <div class="flex gap-8">
                <a
                    href="#"
                    class="hover:text-teal-500 transition-colors underline underline-offset-4"
                >
                    CV / PDF
                </a>
                <a
                    href="#"
                    class="hover:text-accent transition-colors underline underline-offset-4"
                >
                    LinkedIn
                </a>
            </div>
        </div>
    </footer>
</div>

<script is:inline>
    // Simple Client-Side Logic
    const CONTENT = {
        // Small subset of labels for simple text replacement
        it: {
            labels: {
                about: "Info",
                experience: "Esperienza",
                projects: "Progetti Selezionati",
                skills: "Competenze",
                contact: "Contatti",
                footer: "Stefano Perelli / Portfolio 2025",
            },
            bio: "Oltre 10 anni di esperienza nelle trasformazioni digitali. Specializzato nell'ottimizzazione dei processi e nel garantire l'allineamento strategico tra obiettivi di business e roadmap tecnologiche. Gestisco quotidianamente stakeholder complessi e coordino team cross-funzionali con un approccio orientato ai risultati.",
        },
        en: {
            labels: {
                about: "About",
                experience: "Experience",
                projects: "Selected Projects",
                skills: "Capabilities",
                contact: "Contact",
                footer: "Stefano Perelli / Portfolio 2025",
            },
            bio: "Over 10 years of experience in digital transformation. Specialized in process optimization and ensuring strategic alignment between business objectives and technology roadmaps. I lead complex stakeholder environments and coordinate cross-functional teams with a result-oriented approach.",
        },
    };

    function init() {
        // Theme Logic
        const themeToggle = document.getElementById("theme-toggle");
        themeToggle?.addEventListener("click", () => {
            const isDark = document.documentElement.classList.toggle("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
        });

        // Lang Logic
        const langToggle = document.getElementById("lang-toggle");
        let currentLang = localStorage.getItem("lang") || "en";

        const updateLang = (lang) => {
            currentLang = lang;
            localStorage.setItem("lang", lang);

            // Update Toggle Text
            if (langToggle)
                langToggle.textContent = lang === "it" ? "EN" : "IT";

            // Update Simple Text Elements
            document.querySelectorAll("[data-i18n]").forEach((el) => {
                const key = el.getAttribute("data-i18n");
                const keys = key.split(".");
                let val = CONTENT[lang];
                keys.forEach((k) => (val = val[k]));
                if (val) el.textContent = val;
            });

            // Toggle Complex Content Blocks
            // .lang-content-it / .lang-content-en
            if (lang === "it") {
                document
                    .querySelectorAll(".lang-content-it")
                    .forEach((el) => el.classList.remove("hidden"));
                document
                    .querySelectorAll(".lang-content-en")
                    .forEach((el) => el.classList.add("hidden"));
            } else {
                document
                    .querySelectorAll(".lang-content-en")
                    .forEach((el) => el.classList.remove("hidden"));
                document
                    .querySelectorAll(".lang-content-it")
                    .forEach((el) => el.classList.add("hidden"));
            }
        };

        // Initial Render
        updateLang(currentLang);

        langToggle?.addEventListener("click", () => {
            updateLang(currentLang === "it" ? "en" : "it");
        });
    }

    // Run on load
    init();

    // Re-run on view transitions if enabled later
    document.addEventListener("astro:page-load", init);
</script>
