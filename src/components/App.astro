---
import { CONTENT } from "../constants";
import { getCollection } from "astro:content";

import Header from "./Header.astro";
import Footer from "./Footer.astro";

const lang = "en";
const t = CONTENT[lang];

const blogPosts = await getCollection("blog");
const experiments = await getCollection("experiments");

const allItems = [
    ...blogPosts.map((p) => ({
        ...p.data,
        link: `/blog/${p.slug}`,
        type: "POST",
        external: false,
    })),
    ...experiments.map((e) => ({
        ...e.data,
        link: `/experiments/${e.slug}`,
        type: "EXP",
        external: false,
    })),
    ...CONTENT.en.newsletters.map((n) => ({
        ...n,
        date: new Date(n.date),
        type: "NLTR",
        external: true,
    })),
]
    .sort(
        (a, b) =>
            b.pubDate?.valueOf() - a.pubDate?.valueOf() ||
            b.date?.valueOf() - a.date?.valueOf(),
    )
    .slice(0, 8);

const formatDate = (date: Date) =>
    new Date(date).toLocaleDateString("en-US", {
        month: "short",
        day: "2-digit",
        year: "numeric",
    });
---

<div
    class="h-screen overflow-hidden bg-white text-zinc-900 font-sans selection:bg-accent selection:text-white flex flex-col"
>
    <!-- Clean Top Bar -->
    <header class="p-8 md:p-12 flex justify-between items-start outline-none">
        <div class="space-y-1">
            <span
                class="text-[10px] font-black tracking-[0.2em] uppercase text-zinc-300 block"
                >Identity</span
            >
            <span class="text-sm font-bold tracking-tight text-zinc-600"
                >Stefano Perelli</span
            >
        </div>
        <nav class="flex gap-12">
            <a
                href="/about"
                class="text-xs font-black tracking-widest uppercase hover:text-accent transition-colors"
                >About</a
            >
            <a
                href="/resume"
                class="text-xs font-black tracking-widest uppercase hover:text-accent transition-colors"
                >Resume</a
            >
        </nav>
    </header>

    <main
        class="flex-1 flex flex-col max-w-5xl mx-auto w-full px-8 pb-4 overflow-hidden"
    >
        <!-- Brand Header -->
        <div class="mb-12">
            <h1
                class="text-7xl md:text-9xl font-black tracking-tightest leading-none text-zinc-900"
            >
                RAWMODE<span class="text-accent">.</span>
            </h1>
            <p
                class="text-zinc-400 font-medium mt-4 max-w-lg text-lg leading-snug"
                data-i18n="bio"
            >
                {t.bio}
            </p>
        </div>

        <!-- Single Column Activities -->
        <div class="flex-1 flex flex-col justify-start gap-1 overflow-hidden">
            <div class="flex items-center gap-4 mb-4">
                <span
                    class="text-[11px] font-black tracking-[0.3em] uppercase text-accent"
                    >Latest Outputs</span
                >
                <div class="h-[1px] flex-1 bg-zinc-50"></div>
            </div>

            <div class="space-y-1 overflow-y-auto pr-2 no-scrollbar">
                {
                    allItems.map((item) => (
                        <a
                            href={item.link}
                            target={item.external ? "_blank" : "_self"}
                            class="group flex flex-col md:flex-row md:items-center justify-between py-4 transition-all duration-300 hover:pl-4"
                        >
                            <div class="flex items-center gap-6">
                                <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4">
                                    <span class="bg-zinc-100 text-zinc-900 text-[10px] font-black px-2 py-1 rounded group-hover:bg-accent group-hover:text-white transition-colors">
                                        {item.type}
                                    </span>
                                    <h3 class="text-xl md:text-3xl font-black tracking-tight group-hover:text-accent transition-colors">
                                        {item.title}
                                    </h3>
                                </div>
                            </div>
                            <div class="mt-1 md:mt-0 md:text-right">
                                <span class="text-xs md:text-sm font-mono font-bold text-zinc-400 group-hover:text-zinc-900 tabular-nums uppercase">
                                    {formatDate(item.pubDate || item.date)}
                                </span>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- Integrated Small Footer -->
        <footer
            class="mt-auto py-8 flex flex-col md:flex-row justify-between items-center gap-4 border-t border-zinc-50 opacity-50"
        >
            <div class="flex items-center gap-3">
                <div class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse">
                </div>
                <span
                    class="text-[10px] font-mono uppercase text-zinc-400 tracking-widest"
                    >Milan / Buffer Active</span
                >
            </div>
            <div class="flex gap-8 items-center">
                <a
                    href="https://linkedin.com/in/stefanoperelli/"
                    target="_blank"
                    class="text-[10px] font-black tracking-widest uppercase hover:text-accent transition-colors"
                    >LinkedIn</a
                >
                <a
                    href="mailto:sedprc@gmail.com"
                    class="text-[10px] font-black tracking-widest uppercase hover:text-accent transition-colors"
                    >Email</a
                >
                <span
                    class="text-[10px] font-mono text-zinc-300 uppercase tracking-widest"
                    >© 2026 Rawmode</span
                >
            </div>
        </footer>
    </main>
</div>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
