---
import { CONTENT, TAG_STYLES } from "../constants";
import { getCollection } from "astro:content";
import GlobalUI from "../components/GlobalUI.astro";

const t = CONTENT;

const entries = await getCollection("entries", ({ data }) => {
  return data.draft !== true;
});

const allItems = [
  ...entries.map((entry) => ({
    ...entry.data,
    slug: entry.slug,
    link:
      entry.data.type === "link" ? entry.data.url : `/entries/${entry.slug}`,
    isExternal: entry.data.type === "link",
  })),
  ...CONTENT.newsletters.map((n) => ({
    ...n,
    date: new Date(n.date),
    type: "link", // Newsletter is effectively a link
    link: n.link || "#",
    isExternal: true,
    pubDate: new Date(n.date),
  })),
]
  .sort(
    (a, b) => (b.pubDate || b.date).valueOf() - (a.pubDate || a.date).valueOf(),
  )
  .slice(0, 20);

const formatDate = (date: Date) =>
  new Date(date).toLocaleDateString("en-US", {
    month: "2-digit",
    day: "2-digit",
    year: "2-digit",
  });
---

<div
  class="h-screen w-full bg-ink-white text-ink-text font-ink overflow-hidden relative flex flex-col"
>
  <GlobalUI />

  <!-- Central Focus Layer -->
  <main class="flex-1 flex flex-col justify-center items-center z-10">
    <div class="w-full max-w-3xl px-4">
      <div
        class="mb-10 flex justify-between items-end border-b border-ink-black pb-3"
      >
        <span
          class="text-[11px] font-semibold tracking-[0.4em] uppercase text-ink-text"
          >Buffer Outputs // 01—20</span
        >
        <span class="text-[10px] font-ink font-semibold text-ink-text-tertiary"
          >SESSION_2026</span
        >
      </div>

      <div class="flex flex-col space-y-1">
        {
          allItems.map((item, index) => (
            <a
              href={item.link}
              target={item.isExternal ? "_blank" : undefined}
              rel={item.isExternal ? "noopener noreferrer" : undefined}
              class="group flex items-start justify-between py-2 md:py-2 transition-all duration-200 hover:bg-ink-light border-b border-ink-black/10 last:border-0 px-2 -mx-2"
            >
              <div class="flex items-center gap-3 md:gap-6 flex-1 min-w-0">
                <span class="hidden md:block text-[10px] font-ink font-semibold text-ink-text-tertiary group-hover:text-ink-text transition-colors w-6 shrink-0">
                  {(index + 1).toString().padStart(2, "0")}
                </span>
                <span
                  class={`text-[10px] font-semibold px-2 py-0.5 border border-ink-black uppercase tracking-tighter w-10 text-center group-hover:bg-ink-black group-hover:text-ink-white transition-all shrink-0 bg-ink-white text-ink-text`}
                >
                  {TAG_STYLES[item.type as keyof typeof TAG_STYLES]?.label ||
                    item.type}
                </span>
                <h3 class="text-base md:text-xl font-semibold tracking-ink-tight text-ink-text group-hover:text-ink-black transition-colors line-clamp-2 leading-tight flex-1 min-w-0">
                  {item.title}
                  {item.isExternal && (
                    <span class="ml-2 text-ink-text opacity-40 group-hover:opacity-100 transition-opacity">
                      ↗
                    </span>
                  )}
                </h3>
              </div>
              <div class="flex items-center gap-2 md:gap-6 shrink-0 self-center mt-1 md:mt-0">
                <span class="text-xs font-ink font-semibold text-ink-text-tertiary group-hover:text-ink-text transition-colors tabular-nums uppercase">
                  {formatDate(item.pubDate || item.date)}
                </span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  class="w-4 h-4 text-ink-text opacity-0 md:opacity-0 group-hover:opacity-100 transition-all transform -translate-x-3 md:-translate-x-3 group-hover:translate-x-0"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M5 12h14m-7-7l7 7-7 7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</div>
