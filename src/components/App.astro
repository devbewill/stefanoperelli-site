---
import { CONTENT } from "../constants";

import Header from "./Header.astro";
import Footer from "./Footer.astro";

// Load content server-side for initial render (defaulting to English for SEO/SSR)
const lang = "en";
const t = CONTENT[lang];
---

<div
    class="min-h-screen bg-white dark:bg-black text-black dark:text-white transition-colors duration-500 font-sans selection:bg-teal-100 dark:selection:bg-teal-900/30"
>
    <Header />

    <main class="px-6 md:px-12 max-w-[1600px] mx-auto pb-32">
        <div class="flex flex-col md:flex-row gap-12 md:gap-24">
            <div class="w-full md:w-[368px] md:shrink-0">
                <div class="md:sticky md:top-16 space-y-12">
                    <div
                        id="about"
                        class="pt-8 border-t border-zinc-200 dark:border-zinc-800"
                    >
                        <p
                            class="text-md leading-relaxed text-zinc-800 dark:text-zinc-200"
                            data-i18n="bio"
                        >
                            {t.bio}
                        </p>
                    </div>
                    <div class="space-y-0">
                        <div
                            class="py-4 border-t border-zinc-200 dark:border-zinc-800 flex justify-between items-center group"
                        >
                            <a
                                href="mailto:sedprc@gmail.com"
                                class="text-sm hover:text-teal-500 transition-colors underline underline-offset-4 decoration-zinc-300 dark:decoration-zinc-700 group-hover:decoration-teal-500"
                            >
                                Mail me
                            </a>
                        </div>
                        <div
                            class="py-4 border-t border-zinc-200 dark:border-zinc-800 border-b flex justify-between items-center group"
                        >
                            <a
                                href="https://www.linkedin.com/in/stefanoperelli/"
                                class="text-sm hover:text-accent transition-colors underline underline-offset-4 decoration-zinc-300 dark:decoration-zinc-700 group-hover:decoration-accent"
                            >
                                Linkedin
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-1 space-y-32">
                <section id="experience-placeholder">
                    <div
                        class="pt-8 border-t border-zinc-200 dark:border-zinc-800 mb-12"
                    >
                        <h2
                            class="text-sm font-medium text-zinc-500 uppercase tracking-wider"
                            data-i18n="labels.experience"
                        >
                            {t.labels.experience}
                        </h2>
                    </div>
                    <div
                        class="flex items-center justify-center p-16 border-2 border-dashed border-zinc-200 dark:border-zinc-800 rounded-xl bg-zinc-50 dark:bg-zinc-900/20"
                    >
                        <p
                            class="text-zinc-500 dark:text-zinc-400 text-sm italic"
                        >
                            Work Experience Placeholder
                        </p>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <Footer />
</div>
