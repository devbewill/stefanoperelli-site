---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class={`min-h-screen bg-white text-black font-sans flex flex-col relative ${className}`}
>
  <main
    class="flex-1 flex flex-col max-w-2xl mx-auto w-full px-8 pt-64 pb-32"
  >
    <slot />
  </main>
</div>
