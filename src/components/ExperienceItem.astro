---
import type { Experience } from "../types";

interface Props {
    item: Experience;
}

const { item } = Astro.props;
---

<div class="py-12 border-b border-white/5 last:border-0 group">
    <div class="flex flex-col lg:grid lg:grid-cols-3 gap-8">
        <!-- Period & Company -->
        <div class="space-y-4">
            <div class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 rounded-full bg-accent"></div>
                <span
                    class="text-xs font-mono text-zinc-500 uppercase tracking-widest"
                    >{item.period}</span
                >
            </div>
            <div class="space-y-1">
                <a href={item.link} target="_blank" class="block group/link">
                    <h3
                        class="text-2xl font-black tracking-tight flex items-center gap-2 group-hover/link:text-accent transition-colors"
                    >
                        {item.company}
                        <span
                            class="text-accent opacity-0 group-hover/link:opacity-100 group-hover/link:translate-x-1 group-hover/link:-translate-y-1 transition-all"
                            >↗</span
                        >
                    </h3>
                </a>
                <p class="text-sm font-medium text-zinc-400 italic">
                    {item.description}
                </p>
            </div>
        </div>

        <!-- Role & Details -->
        <div class="lg:col-span-2 space-y-6">
            <h4
                class="text-3xl font-black tracking-tighter text-white group-hover:text-accent transition-colors"
            >
                {item.role}
            </h4>

            <ul class="space-y-4">
                {
                    item.details.map((detail) => {
                        const hasColon = detail.includes(":");
                        if (hasColon) {
                            const [title, content] = detail.split(":");
                            return (
                                <li class="flex gap-3 text-base md:text-lg font-medium tracking-tight leading-relaxed">
                                    <span class="text-accent shrink-0 mt-1.5">
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            class="w-3 h-3"
                                            stroke="currentColor"
                                            stroke-width="4"
                                        >
                                            <path
                                                d="M5 12h14m-7-7l7 7-7 7"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            />
                                        </svg>
                                    </span>
                                    <span class="text-zinc-300">
                                        <strong class="text-white font-bold">
                                            {title}:
                                        </strong>{" "}
                                        {content}
                                    </span>
                                </li>
                            );
                        }
                        return (
                            <li class="flex gap-3 text-base md:text-lg font-medium tracking-tight leading-relaxed">
                                <span class="text-accent shrink-0 mt-1.5">
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        class="w-3 h-3"
                                        stroke="currentColor"
                                        stroke-width="4"
                                    >
                                        <path
                                            d="M5 12h14m-7-7l7 7-7 7"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                </span>
                                <span class="text-zinc-300">{detail}</span>
                            </li>
                        );
                    })
                }
            </ul>
        </div>
    </div>
</div>
