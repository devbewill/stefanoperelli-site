---
interface Props {
    period: string;
    company: string;
    role: string;
    description: string;
    details: string[];
}

const { period, company, role, description, details } = Astro.props;
---

<div class="items-start border-b border-ink-black/10 pb-4 last:border-0">
    <!-- Time / Role -->
    <div class="pb-0">
        <div class="text-xs text-gray-500 uppercase tracking-[0.2em]">
            {period}
        </div>
        <div class="text-sm uppercase tracking-widest">
            {role}
        </div>
    </div>

    <!-- Core Content -->
    <div class="space-y-3">
        <div class="space-y-1">
            <h3 class="text-4xl font-bold text-black">
                {company}
            </h3>
            <p class="text-md font-semibold italic">
                {description}
            </p>
        </div>

        <ul class="space-y-4">
            {
                details.map((detail) => (
                    <li class="flex items-start gap-4">
                        <span class="w-1.5 h-1.5 bg-ink-black mt-2 shrink-0" />
                        <p class="text-sm md:text-base font-medium leading-relaxed">
                            {detail}
                        </p>
                    </li>
                ))
            }
        </ul>
    </div>
</div>
