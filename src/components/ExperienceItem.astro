---
interface Props {
    period: string;
    company: string;
    role: string;
    description: string;
    details: string[];
}

const { period, company, role, description, details } = Astro.props;
---

<div class="group grid grid-cols-1 lg:grid-cols-12 gap-8 items-start border-b border-ink-black/10 pb-8 last:border-0">
    <!-- Time / Role -->
    <div class="lg:col-span-2 space-y-2">
        <div
            class="text-[10px] font-ink font-semibold text-ink-text uppercase tracking-[0.2em] group-hover:text-ink-black transition-colors"
        >
            {period}
        </div>
        <div
            class="text-[10px] font-ink font-semibold text-ink-text-tertiary uppercase tracking-widest"
        >
            {role}
        </div>
    </div>

    <!-- Core Content -->
    <div class="lg:col-span-10 space-y-6">
        <div class="space-y-1">
            <h3
                class="text-2xl md:text-3xl font-semibold tracking-ink-tight text-ink-text group-hover:text-ink-black transition-all duration-200"
            >
                {company}
            </h3>
            <p class="text-lg md:text-xl font-semibold text-ink-text-secondary italic">
                {description}
            </p>
        </div>

        <ul class="space-y-4 max-w-2xl">
            {
                details.map((detail) => (
                    <li class="flex items-start gap-4">
                        <span class="w-1.5 h-1.5 bg-ink-black mt-2 shrink-0 opacity-40 group-hover:opacity-100 transition-opacity" />
                        <p class="text-sm md:text-base font-medium text-ink-text-secondary leading-relaxed group-hover:text-ink-text transition-colors">
                            {detail}
                        </p>
                    </li>
                ))
            }
        </ul>
    </div>
</div>
