---
import type { Experience } from "../types";

interface Props {
 item: Experience;
}

const { item } = Astro.props;
---

<div
 class="border-b-[8px] border-black dark:border-white p-4 md:p-8 group hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors"
>
 <div class="flex flex-col lg:flex-row gap-8">
 {/* Left Side: Basic Info */}
 <div class="flex-1 w-full lg:w-1/3">
 <p
 class="text-xl md:text-2xl font-black tracking-tight mb-2 opacity-50"
 >
 {item.period}
 </p>
 <h3
 class="text-3xl md:text-5xl font-black tracking-tight leading-none mb-4"
 >
 {item.role}
 </h3>
 <div class="space-y-2 mt-4">
 <a
 href={item.link}
 class="text-xl md:text-2xl font-black tracking-tighter bg-accent text-black inline-block px-2 group-hover:bg-white group-hover:text-black dark:group-hover:bg-black dark:group-hover:text-accent"
 >
 {item.company} ↗
 </a>
 <p
 class="text-lg md:text-xl font-bold tracking-tighter italic opacity-80 group-hover:opacity-100"
 >
 {item.description}
 </p>
 </div>
 </div>

 {/* Right Side: Details/Bullets */}
 <div class="flex-1 lg:w-2/3">
 <ul class="space-y-4">
 {
 item.details.map((detail) => {
 const hasColon = detail.includes(":");
 if (hasColon) {
 const [title, content] = detail.split(":");
 return (
 <li class="text-lg md:text-xl font-bold tracking-tighter leading-tight">
 <span class="font-black text-accent mr-2 group-hover:text-white dark:group-hover:text-black">
 &gt;
 </span>
 <span class="font-black">{title}:</span>{" "}
 <span class="opacity-80 group-hover:opacity-100">
 {content}
 </span>
 </li>
 );
 }
 return (
 <li class="text-lg md:text-xl font-bold tracking-tighter leading-tight">
 <span class="font-black text-accent mr-2 group-hover:text-white dark:group-hover:text-black">
 &gt;
 </span>
 <span class="opacity-80 group-hover:opacity-100">
 {detail}
 </span>
 </li>
 );
 })
 }
 </ul>
 </div>
 </div>
</div>
