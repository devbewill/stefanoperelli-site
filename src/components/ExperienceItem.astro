---
interface Props {
    title: string;
    company: string;
    location: string;
    period: string;
    details: string[];
}

const { title, company, location, period, details } = Astro.props;
---

<div class="group grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Time / Location -->
    <div class="lg:col-span-3 space-y-2">
        <div
            class="text-[10px] font-mono font-black text-zinc-900 uppercase tracking-[0.2em] group-hover:text-accent transition-colors"
        >
            {period}
        </div>
        <div
            class="text-[10px] font-mono font-bold text-zinc-400 uppercase tracking-widest"
        >
            {location}
        </div>
    </div>

    <!-- Core Content -->
    <div class="lg:col-span-9 space-y-6">
        <div class="space-y-1">
            <h3
                class="text-3xl md:text-5xl font-black tracking-tightest text-zinc-900 group-hover:text-accent transition-all duration-500"
            >
                {company}
            </h3>
            <p class="text-lg md:text-xl font-bold text-zinc-500 italic">
                {title}
            </p>
        </div>

        <ul class="space-y-4 max-w-2xl">
            {
                details.map((detail) => (
                    <li class="flex items-start gap-4">
                        <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 shrink-0 opacity-40 group-hover:opacity-100 transition-opacity" />
                        <p class="text-sm md:text-base font-medium text-zinc-600 leading-relaxed group-hover:text-zinc-900 transition-colors">
                            {detail}
                        </p>
                    </li>
                ))
            }
        </ul>
    </div>
</div>
