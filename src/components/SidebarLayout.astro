---
import BrandIdentity from "./BrandIdentity.astro";
import SidebarNav from "./SidebarNav.astro";
import ContactLinks from "./ContactLinks.astro";

interface Props {
  showMobileHeader?: boolean;
  maxWidth?: string;
}

const { showMobileHeader = true, maxWidth = "max-w-3xl" } = Astro.props;
---

<div class="h-screen w-full bg-ink-white font-ink flex flex-col lg:flex-row overflow-hidden">
  <!-- Left Sidebar: Brand + Navbar (hidden on mobile, shown on desktop) -->
  <aside class="hidden lg:flex  lg:w-80 flex-shrink-0 border-r flex-col p-8 lg:p-12 fixed h-screen">
    <div class="flex-1 flex flex-col">
      <!-- Brand Identity -->
      <div class="mb-12">
        <BrandIdentity />
      </div>

      <!-- Sidebar Navigation (desktop) -->
      <nav class="grid flex-1">
        <SidebarNav id="desktop-nav" />
      </nav>
    </div>
  </aside>

  <!-- Right Content: Scrollable Content (full width on mobile, flex-1 on desktop) -->
  <main class="flex-1 overflow-y-auto h-screen lg:ml-80">
    <div class={`${maxWidth} mx-auto px-6 py-8 lg:p-16`}>
      <!-- Mobile Header: Brand Identity (shown only on mobile) -->
      {showMobileHeader && (
        <div class="lg:hidden mb-8">
          <div class="mb-6">
            <BrandIdentity />
          </div>
        </div>
      )}

      <slot />
    </div>
  </main>

  <!-- Mobile Navigation (hamburger menu, hidden on desktop) -->
  <div class="lg:hidden">
    <SidebarNav id="mobile-nav" />
  </div>

  <!-- Contact Links (fixed position) -->
  <div class="fixed bottom-6 right-6 lg:bottom-12 lg:right-12 pointer-events-auto">
    <ContactLinks />
  </div>
</div>
