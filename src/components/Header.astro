---
import { CONTENT } from "../constants";

const lang = "en";
const t = CONTENT[lang];

const pathname = Astro.url.pathname;
const isActive = (path: string) => {
    if (path === "/") return pathname === "/";
    return pathname.startsWith(path);
};

const getLinkClass = (path: string) => {
    const base = "text-sm lg:text-lg font-black uppercase transition-colors";
    const active = "text-accent bg-black dark:bg-white dark:text-black px-2";
    const inactive =
        "hover:text-accent hover:bg-black dark:hover:bg-white dark:hover:text-black px-2 pb-1";
    return `${base} ${isActive(path) ? active : inactive}`;
};
---

<header
    class="border-b-[8px] md:border-b-[16px] border-black dark:border-white w-full"
>
    <nav class="flex justify-end flex-wrap gap-x-1 gap-y-4 items-center p-2">
        <a href="/" class={getLinkClass("/")}>Base</a>
        <span class="text-xl font-black hidden lg:inline">/</span>
        <a href="/about" class={getLinkClass("/about")} data-i18n="labels.about"
            >{t.labels.about}</a
        >
        <span class="text-xl font-black hidden lg:inline">/</span>
        <a
            href="/resume"
            class={getLinkClass("/resume")}
            data-i18n="labels.experience">{t.labels.experience}</a
        >
        <span class="text-xl font-black hidden lg:inline">/</span>
        <a href="/blog" class={getLinkClass("/blog")}>Blog</a>
        <span class="text-xl font-black hidden lg:inline">/</span>
        <a href="/experiments" class={getLinkClass("/experiments")}>Exp</a>
    </nav>
    <div
        class="px-4 py-8 md:px-8 md:py-16 max-w-[1800px] mx-auto flex flex-col gap-16"
    >
        <div
            class="flex flex-col xl:flex-row justify-between items-start xl:items-end gap-12"
        >
            <div>
                <h1
                    class="text-[16vw] sm:text-[14vw] lg:text-[10vw] font-black tracking-extreme uppercase leading-[0.8] m-0 p-0 whitespace-nowrap"
                >
                    RAWMODE
                </h1>
                <div class="mt-8 flex flex-wrap gap-2">
                    <p
                        class="text-xl md:text-3xl font-black bg-black text-white dark:bg-white dark:text-black inline-block px-4 py-2 uppercase tracking-tighter"
                    >
                        learn, build, share
                    </p>
                    <p
                        class="text-xl md:text-3xl font-black bg-accent text-black inline-block px-4 py-2 uppercase tracking-tighter"
                    >
                        Stefano Perelli
                    </p>
                </div>
            </div>

            <div class="flex gap-4 shrink-0">
                <button
                    id="lang-toggle"
                    class="text-xl font-black uppercase tracking-tighter border-[6px] border-black dark:border-white px-2 hover:bg-accent hover:border-accent hover:text-black transition-colors"
                >
                    EN
                </button>
                <button
                    id="theme-toggle"
                    class="text-xl font-black uppercase tracking-tighter border-[6px] border-black dark:border-white px-2 hover:bg-accent hover:border-accent hover:text-black transition-colors"
                >
                    <span class="dark:hidden">DARK</span>
                    <span class="hidden dark:inline">LIGHT</span>
                </button>
            </div>
        </div>
    </div>
</header>

<script is:inline>
    // Copying the standard header script but making sure it works perfectly
    const CONTENT = {
        it: {
            labels: {
                about: "Info",
                experience: "Esperienza",
                projects: "Progetti",
                skills: "Competenze",
                contact: "Contatti",
                now: "Ora",
                activities: "Attività",
            },
            bio: "Oltre 10 anni di esperienza nelle trasformazioni digitali. Allineamento strategico e roadmap. Design estremo.",
            now: "Studio AI e project management ignorando le UI noiose.",
        },
        en: {
            labels: {
                about: "About",
                experience: "Experience",
                projects: "Projects",
                skills: "Skills",
                contact: "Contact",
                now: "Now",
                activities: "Activity",
            },
            bio: "10+ years driving digital transformation. Eradicating boring UIs while aligning strategy and tech roadmaps.",
            now: "Exploring the AI ecosystem and building experimental tools with aggressive brutalism.",
        },
    };

    function initHeader() {
        const themeToggle = document.getElementById("theme-toggle");
        const newThemeToggle = themeToggle?.cloneNode(true);
        if (themeToggle && newThemeToggle) {
            themeToggle.parentNode.replaceChild(newThemeToggle, themeToggle);
            newThemeToggle.addEventListener("click", () => {
                const isDark =
                    document.documentElement.classList.toggle("dark");
                localStorage.setItem("theme", isDark ? "dark" : "light");
            });
        }

        const langToggle = document.getElementById("lang-toggle");
        let currentLang = localStorage.getItem("lang") || "en";

        const updateLang = (lang) => {
            currentLang = lang;
            localStorage.setItem("lang", lang);

            const newLangToggle = document.getElementById("lang-toggle");
            if (newLangToggle)
                newLangToggle.textContent = lang === "it" ? "EN" : "IT";

            document.querySelectorAll("[data-i18n]").forEach((el) => {
                const key = el.getAttribute("data-i18n");
                const keys = key.split(".");
                let val = CONTENT[lang];
                keys.forEach((k) => (val = val && val[k]));
                if (val) el.textContent = val;
            });

            if (document.querySelector(".lang-content-it")) {
                if (lang === "it") {
                    document
                        .querySelectorAll(".lang-content-it")
                        .forEach((el) => el.classList.remove("hidden"));
                    document
                        .querySelectorAll(".lang-content-en")
                        .forEach((el) => el.classList.add("hidden"));
                } else {
                    document
                        .querySelectorAll(".lang-content-en")
                        .forEach((el) => el.classList.remove("hidden"));
                    document
                        .querySelectorAll(".lang-content-it")
                        .forEach((el) => el.classList.add("hidden"));
                }
            }
        };

        updateLang(currentLang);

        const newLangToggle = document.getElementById("lang-toggle");
        const fresherLangToggle = newLangToggle?.cloneNode(true);
        if (newLangToggle && fresherLangToggle) {
            newLangToggle.parentNode.replaceChild(
                fresherLangToggle,
                newLangToggle,
            );
            fresherLangToggle.addEventListener("click", () => {
                updateLang(currentLang === "it" ? "en" : "it");
            });
        }
    }

    initHeader();
    document.addEventListener("astro:page-load", initHeader);
</script>
