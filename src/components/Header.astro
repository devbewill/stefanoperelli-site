---
import { CONTENT } from "../constants";

const lang = "en";
const t = CONTENT[lang];

const pathname = Astro.url.pathname;
const isActive = (path: string) => {
    if (path === "/") return pathname === "/";
    return pathname.startsWith(path);
};
---

<header
    class="fixed top-0 left-0 w-full z-50 p-8 md:p-12 lg:p-16 flex justify-between items-start pointer-events-none"
>
    <div class="pointer-events-auto">
        <a href="/" class="group flex flex-col">
            <h1
                class="text-2xl lg:text-3xl font-black tracking-tightest leading-none text-zinc-900"
            >
                SYNTHETIC MESS<span class="text-accent">_</span>
            </h1>
            <span
                class="text-[8px] font-bold text-accent uppercase tracking-[0.2em] opacity-0 group-hover:opacity-100 transition-opacity"
            >
                Order is overrated.
            </span>
        </a>
    </div>

    <nav class="flex gap-8 lg:gap-12 pointer-events-auto items-center">
        <a
            href="/about"
            class={`text-[10px] font-black tracking-widest uppercase transition-colors ${isActive("/about") ? "text-accent" : "text-zinc-400 hover:text-black"}`}
            data-i18n="labels.about">{t.labels.about}</a
        >
        <a
            href="/resume"
            class={`text-[10px] font-black tracking-widest uppercase transition-colors ${isActive("/resume") ? "text-accent" : "text-zinc-400 hover:text-black"}`}
            data-i18n="labels.experience">{t.labels.experience}</a
        >
        <a
            href="/blog"
            class={`text-[10px] font-black tracking-widest uppercase transition-colors ${isActive("/blog") ? "text-accent" : "text-zinc-400 hover:text-black"}`}
            >Blog</a
        >
        <a
            href="/experiments"
            class={`text-[10px] font-black tracking-widest uppercase transition-colors ${isActive("/experiments") ? "text-accent" : "text-zinc-400 hover:text-black"}`}
            >Exp</a
        >
    </nav>
</header>
