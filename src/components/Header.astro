---
import { CONTENT } from "../constants";

// Default content for static parts
const lang = "en";
const t = CONTENT[lang];

// Check current path to determine link behavior
const pathname = Astro.url.pathname;
const isActive = (path: string) => {
    if (path === "/") {
        return pathname === "/";
    }
    return pathname.startsWith(path);
};

const getLinkClass = (path: string) => {
    const baseClass = "text-xl font-medium transition-colors hidden sm:block";
    const activeClass = "text-teal-600 dark:text-teal-400";
    const inactiveClass = "hover:text-accent";

    return `${baseClass} ${isActive(path) ? activeClass : inactiveClass}`;
};
---

<header
    class="px-6 py-12 md:px-12 md:py-16 flex justify-between items-start max-w-[1600px] mx-auto"
>
    <div>
        <h1 class="text-xl font-bold tracking-tight">stefano_perelli</h1>
        <p class="text-md text-teal-600 dark:text-teal-400 font-medium">
            turning digital messes into great products.
        </p>
    </div>
    <nav class="flex items-center gap-6 md:gap-8">
        <a href="/" class={getLinkClass("/")}> Home </a>
        <a
            href="/about"
            class={getLinkClass("/about")}
            data-i18n="labels.about"
        >
            {t.labels.about}
        </a>
        <a
            href="/resume"
            class={getLinkClass("/resume")}
            data-i18n="labels.experience"
        >
            {t.labels.experience}
        </a>
        <a href="/blog" class={getLinkClass("/blog")}> Blog </a>
        <div class="flex gap-2">
            <button
                id="lang-toggle"
                class="text-[10px] font-mono tracking-widest border border-zinc-200 dark:border-zinc-800 px-3 py-1 rounded-full uppercase hover:border-teal-500 hover:text-teal-500 transition-colors"
            >
                {/* Default text, client script will update */}
                EN
            </button>
            <button
                id="theme-toggle"
                class="text-[10px] font-mono tracking-widest border border-zinc-200 dark:border-zinc-800 px-3 py-1 rounded-full uppercase hover:border-accent hover:text-accent transition-colors"
            >
                <span class="dark:hidden">Dark</span>
                <span class="hidden dark:inline">Light</span>
            </button>
        </div>
    </nav>
</header>

<script is:inline>
    // Global Header Logic (Theme + I18n)
    const CONTENT = {
        it: {
            labels: {
                about: "Info",
                experience: "Esperienza",
                projects: "Progetti Selezionati",
                skills: "Competenze",
                contact: "Contatti",
                footer: "Stefano Perelli / Portfolio 2025",
            },
            bio: "Oltre 10 anni di esperienza nelle trasformazioni digitali. Specializzato nell'ottimizzazione dei processi e nel garantire l'allineamento strategico tra obiettivi di business e roadmap tecnologiche. Gestisco quotidianamente stakeholder complessi e coordino team cross-funzionali con un approccio orientato ai risultati.",
        },
        en: {
            labels: {
                about: "About",
                experience: "Experience",
                projects: "Selected Projects",
                skills: "Capabilities",
                contact: "Contact",
                footer: "Stefano Perelli / Portfolio 2025",
            },
            bio: "Over 10 years of experience in digital transformation. Specialized in process optimization and ensuring strategic alignment between business objectives and technology roadmaps. I lead complex stakeholder environments and coordinate cross-functional teams with a result-oriented approach.",
        },
    };

    function initHeader() {
        // Theme Logic
        const themeToggle = document.getElementById("theme-toggle");
        // Clone to replace any existing listener if this script runs multiple times
        const newThemeToggle = themeToggle?.cloneNode(true);
        if (themeToggle && newThemeToggle) {
            themeToggle.parentNode.replaceChild(newThemeToggle, themeToggle);
            newThemeToggle.addEventListener("click", () => {
                const isDark =
                    document.documentElement.classList.toggle("dark");
                localStorage.setItem("theme", isDark ? "dark" : "light");
            });
        }

        // Lang Logic
        const langToggle = document.getElementById("lang-toggle");
        let currentLang = localStorage.getItem("lang") || "en";

        const updateLang = (lang) => {
            currentLang = lang;
            localStorage.setItem("lang", lang);

            // Update Toggle Text only
            // Note: If we are on blog, we might NOT want to translate main content
            // because there is no content to translate (unless we move some labels there).
            // But we SHOULD update labels in the header.

            const newLangToggle = document.getElementById("lang-toggle");
            if (newLangToggle)
                newLangToggle.textContent = lang === "it" ? "EN" : "IT";

            // Update Simple Text Elements (Global)
            document.querySelectorAll("[data-i18n]").forEach((el) => {
                const key = el.getAttribute("data-i18n");
                const keys = key.split(".");
                let val = CONTENT[lang];
                keys.forEach((k) => (val = val && val[k]));
                if (val) el.textContent = val;
            });

            // Toggle Complex Content Blocks (Specific to Home App)
            // We check if these exist before trying to toggle
            if (document.querySelector(".lang-content-it")) {
                if (lang === "it") {
                    document
                        .querySelectorAll(".lang-content-it")
                        .forEach((el) => el.classList.remove("hidden"));
                    document
                        .querySelectorAll(".lang-content-en")
                        .forEach((el) => el.classList.add("hidden"));
                } else {
                    document
                        .querySelectorAll(".lang-content-en")
                        .forEach((el) => el.classList.remove("hidden"));
                    document
                        .querySelectorAll(".lang-content-it")
                        .forEach((el) => el.classList.add("hidden"));
                }
            }
        };

        // Initial Render
        updateLang(currentLang);

        const newLangToggle = document.getElementById("lang-toggle");
        // Replace listener
        const fresherLangToggle = newLangToggle?.cloneNode(true);
        if (newLangToggle && fresherLangToggle) {
            newLangToggle.parentNode.replaceChild(
                fresherLangToggle,
                newLangToggle,
            );
            fresherLangToggle.addEventListener("click", () => {
                updateLang(currentLang === "it" ? "en" : "it");
            });
        }
    }

    // Run on load
    initHeader();
    document.addEventListener("astro:page-load", initHeader);
</script>
